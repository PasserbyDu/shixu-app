<script setup lang="uts">
	import { toast } from '@/utils/toast'

	// #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0

	onLastPageBackPress(() => {
		const now = Date.now()
		if (firstBackTime > 0 && now - firstBackTime < 2000) {
			uni.exit()
			return
		}
		firstBackTime = now
		toast('再按一次退出应用', { position: 'bottom' })
	})
	// #endif
</script>

<style lang="scss">
	@import "@/styles/index.scss";
</style>
