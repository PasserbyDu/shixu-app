// 页面只选择工具 ID，不再重复定义工具信息。
export const HOME_TOOL_IDS : string[] = ['image', 'date', 'json', 'deposit']
export const MINE_TOOL_IDS : string[] = ['image', 'date', 'json', 'deposit']
export const DEFAULT_FAVORITE_IDS : string[] = ['image', 'date', 'deposit', 'image-pdf', 'json', 'fitness']
export const RECOMMENDED_TOOL_IDS : string[] = ['pet', 'text', 'unit']

// methods
// 兼容早期页面中的旧 ID，收藏统一保存为正式 ID。
export const getTool = (id : string) : Tool | null => {
	let canonicalId = id
	if (id == 'image-compress') canonicalId = 'image'
	if (id == 'interest') canonicalId = 'deposit'
	const tool = tools.find((item : Tool) : boolean => item.id == canonicalId)
	return tool == null ? null : tool
}

// 已实现的工具路由统一在此维护，其他工具继续显示待接入提示。
export const getToolPath = (id : string) : string => {
	const tool = getTool(id)
	if (tool == null) return ''
	switch (tool.id) {
		case 'date':
			return '/subPackages/life/date-difference'
		case 'time':
			return '/subPackages/life/time-calculator'
		case 'unit':
			return '/subPackages/life/unit-converter'
	}
	return ''
}

// 按传入 ID 顺序返回，跳过不存在的 ID 并去重。
export const getToolsByIds = (ids : string[]) : Tool[] => {
	const result : Tool[] = []
	ids.forEach((id : string) => {
		const tool = getTool(id)
		if (tool == null) return
		if (result.some((item : Tool) : boolean => item.id == tool.id)) return
		result.push(tool)
	})
	return result
}

export const getAllTools = () : Tool[] => {
	return tools.slice()
}

export const getToolCategories = () : ToolCategory[] => {
	return categories.slice()
}

export const getToolsByCategory = (categoryId : string) : Tool[] => {
	if (categoryId == 'all') return getAllTools()
	const category = categories.find((item : ToolCategory) : boolean => item.id == categoryId)
	if (category == null) return []
	return getToolsByIds(category.toolIds)
}

// 不传分类时返回所有非空分组；传分类 ID 可仅取指定分组。
export const getToolGroups = (categoryIds : string[] = [], includeEmpty : boolean = false) : ToolGroup[] => {
	const result : ToolGroup[] = []
	categories.forEach((category : ToolCategory) => {
		if (categoryIds.length > 0 && !categoryIds.includes(category.id)) return
		const items = getToolsByCategory(category.id)
		if (!includeEmpty && items.length == 0) return
		result.push({ id: category.id, title: category.title, icon: category.icon, count: items.length, tools: items })
	})
	return result
}
