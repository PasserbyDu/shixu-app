// types
export type Tool = {
	id : string
	title : string
	shortTitle : string
	summary : string
	description : string
	keywords : string
	icon : string
	iconText : string
	color : string
	background : string
}

export type ToolCategory = {
	id : string
	title : string
	shortTitle : string
	subtitle : string
	icon : string
	color : string
	background : string
	toolIds : string[]
}

export type ToolGroup = {
	id : string
	title : string
	icon : string
	count : number
	tools : Tool[]
}

