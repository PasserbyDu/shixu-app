	<view class="empty-state column-center">
		<image
			v-if="image.length > 0"
			class="empty-image"
			:src="image"
			mode="aspectFit"
		/>
		<text v-if="description.length > 0" class="fs28 text-color-grey mt28">{{ description }}</text>
		<slot />
	</view>
</template>

<script setup lang="uts">
	const props = withDefaults(defineProps<{
		image ?: string
		description ?: string
	}>(), {
		image: '/static/empty.png',
		description: ''
	})
</script>

<style scoped lang="scss">
	@import "@/uni.scss";

	/*
	 * 使用约束：父级容器必须为 flex 列布局，页面根节点设置 flex: 1。
	 *
	 * 推荐链：page-root (flex: 1)
