export type JsonToken = { text : string, kind : string, position : number }
type JsonFrame = { kind : string, state : string }

// methods
export const sourceError = (source : string, position : number, message : string) : Error => {
	let line = 1
	let column = 1
	for (let index = 0; index < Math.min(position, source.length); index++) {
		if (source[index] == '\r') { line++; column = 1; if (index + 1 < Math.min(position, source.length) && source[index + 1] == '\n') index++ }
		else if (source[index] == '\n') { line++; column = 1 }
		else column++
	}
	return new Error('第 ' + line + ' 行，第 ' + column + ' 列：' + message)
}

const jsonTokens = (source : string) : JsonToken[] => {
	const tokens : JsonToken[] = []
	let index = 0
	while (index < source.length) {
		const char = source[index]
		if (/[ \t\r\n]/.test(char)) { index++; continue }
		const start = index
		if ('{}[]:,'.includes(char)) { tokens.push({ text: char, kind: char, position: index }); index++; continue }
		if (char == '"') {
			index++
			let closed = false
			while (index < source.length) {
				if (source[index] == '"') { index++; closed = true; break }
				if (source.charCodeAt(index) < 32) throw sourceError(source, index, '字符串中包含未转义的控制字符')
				if (source[index] == '\\') {
					index++
					if (index >= source.length) throw sourceError(source, index, '转义字符不完整')
					if (source[index] == 'u') {
						if (!/^[0-9a-fA-F]{4}$/.test(source.slice(index + 1, index + 5))) throw sourceError(source, index, 'Unicode 转义需为四位十六进制数')
						index += 5
						continue
					}
					if (!'"\\/bfnrt'.includes(source[index])) throw sourceError(source, index, '无效的字符串转义')
				}
				index++
			}
			if (!closed) throw sourceError(source, start, '字符串缺少结束双引号')
			tokens.push({ text: source.slice(start, index), kind: 'string', position: start })
			continue
		}
		if (char == '-' || /[0-9]/.test(char)) {
			const match = source.slice(index).match(/^-?(0|[1-9]\d*)(\.\d+)?([eE][+-]?\d+)?/)
			if (match == null) throw sourceError(source, index, '无效的 JSON 数字')
			index += match[0].length
			tokens.push({ text: match[0], kind: 'value', position: start })
			continue
		}
		const literal = ['true', 'false', 'null'].find((value : string) : boolean => source.slice(index, index + value.length) == value)
		if (literal != null) { tokens.push({ text: literal, kind: 'value', position: start }); index += literal.length; continue }
		throw sourceError(source, index, '不符合标准 JSON；请检查双引号、注释或多余字符')
	}
	return tokens
}

const validateJsonTokens = (source : string, tokens : JsonToken[]) => {
	const stack : JsonFrame[] = []
	let rootComplete = false
	for (let index = 0; index < tokens.length; index++) {
		const token = tokens[index]
		const frame = stack.length > 0 ? stack[stack.length - 1] : null
		if (frame != null) {
			if (frame.kind == 'object' && (frame.state == 'keyOrEnd' || frame.state == 'key')) {
				if (token.kind == '}' && frame.state == 'keyOrEnd') { stack.pop(); continue }
				if (token.kind != 'string') throw sourceError(source, token.position, '对象键必须使用双引号，末项后不能加逗号')
				frame.state = 'colon'
				continue
			}
			if (frame.state == 'colon') {
				if (token.kind != ':') throw sourceError(source, token.position, '对象键后缺少冒号')
				frame.state = 'value'
				continue
			}
			if (frame.state == 'commaOrEnd') {
				if (token.kind == (frame.kind == 'object' ? '}' : ']')) { stack.pop(); continue }
				if (token.kind != ',') throw sourceError(source, token.position, '相邻成员之间缺少逗号，或结束括号不匹配')
				frame.state = frame.kind == 'object' ? 'key' : 'value'
				continue
			}
			if (frame.kind == 'array' && frame.state == 'valueOrEnd' && token.kind == ']') { stack.pop(); continue }
		} else if (rootComplete) throw sourceError(source, token.position, 'JSON 根值后还有多余内容')
		if (!['string', 'value', '{', '['].includes(token.kind)) throw sourceError(source, token.position, '此处需要有效的 JSON 值，不能有尾随逗号')
		if (frame != null) frame.state = 'commaOrEnd'
		else rootComplete = true
		if (token.kind == '{' || token.kind == '[') {
			if (stack.length >= 200) throw sourceError(source, token.position, '嵌套层级不能超过 200 层')
			stack.push({ kind: token.kind == '{' ? 'object' : 'array', state: token.kind == '{' ? 'keyOrEnd' : 'valueOrEnd' })
		}
	}
	if (!rootComplete) throw sourceError(source, 0, '请输入 JSON 内容')
	if (stack.length > 0) throw sourceError(source, source.length, '内容未结束，请检查缺少的值或结束括号')
}

// 保留数字原始字面量、键顺序和重复键，不经过浮点数反序列化。
export const formatJson = (source : string, indentation : number, compact : boolean = false) : string => {
	if (source.length > 20000) throw new Error('最多支持 20,000 字符')
	if (![2, 4].includes(indentation)) throw new Error('请选择 2 或 4 个空格缩进')
	const tokens = jsonTokens(source)
	validateJsonTokens(source, tokens)
	if (compact) return tokens.map((token : JsonToken) : string => token.text).join('')
	const output : string[] = []
	let depth = 0
	for (let index = 0; index < tokens.length; index++) {
		const text = tokens[index].text
		const previous = index > 0 ? tokens[index - 1].text : ''
		const next = index + 1 < tokens.length ? tokens[index + 1].text : ''
		if (text == '{' || text == '[') {
			output.push(text)
			depth++
			if (next != (text == '{' ? '}' : ']')) output.push('\n' + ' '.repeat(depth * indentation))
		} else if (text == '}' || text == ']') {
			depth--
			if (previous != (text == '}' ? '{' : '[')) output.push('\n' + ' '.repeat(depth * indentation))
			output.push(text)
		} else if (text == ',') output.push(',\n' + ' '.repeat(depth * indentation))
		else if (text == ':') output.push(': ')
		else output.push(text)
	}
	const result = output.join('')
	if (result.length > 400000) throw new Error('格式化结果过大，请减少内容或缩进层级')
	return result
}
