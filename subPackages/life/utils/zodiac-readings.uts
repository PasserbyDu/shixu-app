export type ReadingSection = { title: string, text: string }
export type CultureReading = { name: string, tag: string, sections: ReadingSection[] }

// 通俗星座文化和生肖民俗的编辑性整理；并非按出生时刻生成的星盘、八字或流年预测。
// 每行：名称 | 四象 | 模式 | 性格 | 合拍参考 | 相处建议 | 趣味运势。
const starRows: string[] = [
	'白羊座|火象|基本宫|热情直接，愿意率先行动，遇事有冲劲；也容易急于看到结果。|狮子座、射手座：同属火象，容易在行动与冒险中找到共鸣。|给彼此直说的空间，争执时先缓一缓，把冲劲用在共同目标上。|行动是机会的入口。适合主动推进搁置的计划；先确认方向，再迈出第一步。',
	'金牛座|土象|固定宫|重视稳定、感官体验与承诺，耐心积累；面对变化时需要适应时间。|处女座、摩羯座：同属土象，更容易理解彼此对踏实与长期关系的重视。|以稳定行动表达关心，讨论变化时给出清晰安排，不催促对方立刻决定。|积累比速度更有力量。适合整理生活、坚持一项手艺，也记得为新体验留点空间。',
	'双子座|风象|变动宫|好奇灵活，擅长交流和连接信息；兴趣多，也可能分散注意力。|天秤座、水瓶座：同属风象，谈话、想法与新鲜体验容易成为连接。|保持交流，也把约定落实；遇到重要问题，少些试探，多说真实想法。|交流带来灵感。适合学习、写作和认识不同观点，选定一件事做完更有收获。',
	'巨蟹座|水象|基本宫|敏感细腻，珍惜熟悉的人与安全感，善于照顾；也容易把情绪藏在心里。|天蝎座、双鱼座：同属水象，较容易理解彼此的情感表达和依恋需求。|把期待说清楚，不用沉默考验关心；照顾别人时，也为自己保留边界。|安定内心才能向外生长。适合整理居所、修复沟通，给自己安排规律的休息。',
	'狮子座|火象|固定宫|自信慷慨，重视表达与认可，乐于带动气氛；有时较在意面子。|白羊座、射手座：同属火象，热情与共同体验容易点燃关系。|坦诚赞赏彼此的付出，也让对方拥有舞台；分歧时先听完再回应。|表达让机会被看见。适合展示作品、承担责任，以真诚合作延续热情。',
	'处女座|土象|变动宫|细致认真，善于分析、整理和改进；标准较高时，容易对自己过于苛刻。|金牛座、摩羯座：同属土象，容易在秩序、责任与日常照顾上形成默契。|将建议说成邀请，先肯定再讨论改进；允许关系保留一点不完美。|细节里藏着进步。适合梳理流程、复盘习惯；做到足够好之后，也要允许自己休息。',
	'天秤座|风象|基本宫|重视公平、审美与关系协调，善于换位思考；选择太多时容易犹豫。|双子座、水瓶座：同属风象，交流与互相尊重能让关系更轻松。|体谅彼此也表达立场；把共同选择拆成小问题，避免只为和气而勉强答应。|平衡来自清楚的取舍。适合协作、沟通和整理环境，先确定自己真正重视的事。',
	'天蝎座|水象|固定宫|投入深入，观察敏锐，珍视信任与情感深度；不安时可能过度揣测。|巨蟹座、双鱼座：同属水象，较容易理解情绪深度与亲密需求。|坦诚谈边界，少猜测、多核实；信任需要稳定的行动，不靠反复试探。|专注有助于深入突破。适合钻研一个问题，放下无法控制的部分，给关系留些呼吸空间。',
	'射手座|火象|变动宫|乐观直率，向往自由与探索，愿意尝试；有时忽略细节或话说得太快。|白羊座、狮子座：同属火象，容易因共同兴趣、远行和行动力而合拍。|尊重独立空间，同时说清承诺；直率之前，照顾一下对方的感受。|探索打开视野。适合学习新领域、规划体验，把灵感拆成能完成的小步骤。',
	'摩羯座|土象|基本宫|务实自律，有责任感和目标意识，愿意长期投入；压力大时容易绷得太紧。|金牛座、处女座：同属土象，稳定与可靠往往比热闹更能打动彼此。|别只用承担表达爱，也说说自己的需要；为相处安排不带任务的时间。|长期主义是优势。适合设定阶段目标、积累技能，适当求助能让前进更稳。',
	'水瓶座|风象|固定宫|独立理性，重视平等、创意与个人空间；有时显得抽离或难以捉摸。|双子座、天秤座：同属风象，共享观点与尊重差异容易建立连接。|给彼此自由，也保持情感回应；理念不同不等于无法相处，先谈具体需要。|新视角带来转机。适合尝试不同方法、参与协作，让创意落在实际行动上。',
	'双鱼座|水象|变动宫|共情丰富，有想象力，容易被氛围打动；也可能因为心软而模糊边界。|巨蟹座、天蝎座：同属水象，细腻回应与情绪理解容易产生共鸣。|温柔也要说清界限；表达期待时用具体约定，别让对方一直猜。|灵感需要落地。适合创作、记录感受，把一个愿望拆成今天能做的一件小事。'
]

// 名称 | 地支 | 地支五行 | 性情 | 六合 | 三合另两属相 | 民俗运势 | 修身小笺。
// 地支五行不等于个人八字喜用神，也不据此推定整个人的五行属性。
const animalRows: string[] = [
	'鼠|子|水|民俗取其机敏善察、灵活应变之象，善于在细微处发现机会；心思活络，也须防想得过多。|牛|猴、龙|子水灵动，宜以静制动、先谋后行。人缘之机多在日常往来，守信比机巧更能聚福。|小事不失信，大事不贪快；把聪明用在长久的积累上。',
	'牛|丑|土|民俗取其敦厚勤恳、负重耕耘之象，做事有恒心；认准方向后，有时不易转弯。|鼠|蛇、鸡|丑土厚重，宜守正勤耕、厚积薄发。与其急求显达，不如把手边之事做扎实。|耕耘之外也要抬头看路，听取不同意见，劳逸有度。',
	'虎|寅|木|民俗取其勇毅果敢、昂扬有势之象，喜欢开拓和担当；意气上来，也需留意锋芒。|猪|马、狗|寅木向阳，宜乘势而为、刚柔并济。进取须有章法，与人和气，方能行得长远。|有胆识也要有耐心，逢急事先定心，遇强势时留余地。',
	'兔|卯|木|民俗取其温雅敏慧、知进知退之象，重视和气与体面；为顾全关系，有时委屈自己。|狗|猪、羊|卯木舒展，宜养和气、稳中求进。人际贵在真诚，温和之中守住自己的分寸。|和而不同，不必事事迁就；把心意与界限都说清。',
	'龙|辰|土|民俗取其昂扬奋发、气度开阔之象，富有理想与担当；目标宏大时，尤其需要落地。|鸡|鼠、猴|辰为湿土，民俗有蓄势待时之意。宜立志而不躁进，借协作之力，将远景落成实事。|志向宜远，脚步宜稳；少些逞强，多些倾听。',
	'蛇|巳|火|民俗取其沉静善思、洞察敏锐之象，讲究谋定而动；心事较深时，不易向人示弱。|猴|牛、鸡|巳火内明，宜藏锋养智、谋定后动。机会不必声张，关系仍需坦诚，独思也须兼听。|审慎不等于猜疑，想清楚后勇于行动，也给人解释的机会。',
	'马|午|火|民俗取其奔放爽朗、行动迅捷之象，向往自由，乐于开路；热情过盛时易急躁。|羊|虎、狗|午火明朗，宜顺势而行、张弛有度。奔赴目标时留意节奏，热心与守诺同样重要。|行快也要看路，为自己留一程休息，为承诺留一分耐心。',
	'羊|未|土|民俗取其温厚仁善、细腻重情之象，善于体谅和营造安稳；也容易顾虑过多。|马|兔、猪|未土含和，宜以和为贵、柔中有守。善意能结人缘，适当坚定，才不负自己的心力。|温柔不是退让到底；把善意留给值得的人，也照顾自己。',
	'猴|申|金|民俗取其聪颖机巧、应变灵活之象，善于求新与解难；兴趣多时，需防浅尝即止。|蛇|鼠、龙|申金善变通，宜用巧而不取巧。新路可试，根基不可轻，持之以恒才能让才思见功。|聪明之外贵在专一，定下一事，耐心做到收尾。',
	'鸡|酉|金|民俗取其勤谨守时、讲究条理之象，眼光细致，敢于表达；标准太严时易言语锋利。|龙|蛇、牛|酉金重精整，宜修细节、守时信。认真能见口碑，言语留温度，处事更易得和。|看得清也说得柔，先肯定付出，再商量改进。',
	'狗|戌|土|民俗取其忠诚正直、重诺守护之象，讲义气与原则；责任背得太多时容易紧绷。|兔|虎、马|戌土重守成，宜守信立身、稳固根基。为人尽心，也要分清责任边界，方能安稳长久。|守原则而不固执，肯助人也肯求助，莫独自担尽风雨。',
	'猪|亥|水|民俗取其宽厚诚恳、随和有福之象，重视舒适与情义；安逸之中也需保持主动。|虎|兔、羊|亥水涵养，宜养精蓄锐、以诚待人。所谓福气，民俗多寄托于知足、和睦与踏实经营。|知足也要有目标，待人宽厚，做事有始有终。'
]

export const starReading = (name: string): CultureReading | null => {
	const row = starRows.find((value: string): boolean => value.split('|')[0] == name)
	if (row == null) return null
	const p = row.split('|')
	return { name, tag: p[1] + '星座 · ' + p[2], sections: [
		{ title: '性格画像', text: p[3] }, { title: '合拍星座 · 传统配对参考', text: p[4] },
		{ title: '相处小提示', text: p[5] }, { title: '运势启发 · 非每日预测', text: p[6] }
	] }
}
export const animalReading = (name: string): CultureReading | null => {
	const row = animalRows.find((value: string): boolean => value.split('|')[0] == name)
	if (row == null) return null
	const p = row.split('|')
	return { name: '生肖' + name, tag: '地支' + p[1] + ' · 地支五行属' + p[2], sections: [
		{ title: '生肖性情', text: p[3] },
		{ title: '六合 · 民俗中的相契之缘', text: '与' + p[4] + '为六合，传统生肖说法中象征互相照应、取长补短。' },
		{ title: '三合 · 民俗中的同道之缘', text: name + '、' + p[5] + '构成三合组合，常被用来寄托协作和睦的愿望。' },
		{ title: '民俗运势 · 宜与守', text: p[6] }, { title: '修身小笺', text: p[7] }
	] }
}
