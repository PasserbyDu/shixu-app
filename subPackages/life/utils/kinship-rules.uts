// Adapted from mumuy/relationship filter rules (MIT). See relationship.LICENSE.
export type KinshipRule = { pattern : RegExp, replacement : string }
export const KINSHIP_RULES : KinshipRule[] = [
	{ pattern: /^(.+)&o([^#]+)&l/g, replacement: '$1$2' },
	{ pattern: /^(.+)&l([^#]+)&o/g, replacement: '$1$2' },
	{ pattern: /^(.+)?,o([sb](&\d+)?)([^#]+)&l/g, replacement: '$1,x$2$4' },
	{ pattern: /^(.+)?,l([sb](&\d+)?)([^#]+)&o/g, replacement: '$1,x$2$4' },
	{ pattern: /(,o[sb](&\d+)?)+(,o[sb])(&\d+)?/, replacement: '$3$4' },
	{ pattern: /(,l[sb](&\d+)?)+(,l[sb])(&\d+)?/, replacement: '$3$4' },
	{ pattern: /^(.*,[fh1])(,[olx][sb](&\d+)?)+,[olx]b(.*)$/, replacement: '$1,xb$4#$1$4' },
	{ pattern: /^(.*,[mw0])(,[olx][sb](&\d+)?)+,[olx]s(.*)$/, replacement: '$1,xs$4#$1$4' },
	{ pattern: /(,[fh1])(,[olx][sb](&\d+)?)+,[olx]s/g, replacement: '$1,xs' },
	{ pattern: /(,[mw0])(,[olx][sb](&\d+)?)+,[olx]b/g, replacement: '$1,xb' },
	{ pattern: /^,[olx][sb](&\d+)?,[olx]b(.+)?$/, replacement: ',xb$2#$2' },
	{ pattern: /^,[olx][sb](&\d+)?,[olx]s(.+)?$/, replacement: ',xs$2#$2' },
	{ pattern: /^,x([sb])$/, replacement: ',o$1#,l$1' },
	{ pattern: /m,h/g, replacement: 'f' },
	{ pattern: /f,w/g, replacement: 'm' },
	{ pattern: /,[xol][sb](&\d+)?(,[mf])/g, replacement: '$2' },
	{ pattern: /,[mf],d(&\d+)/, replacement: ',xs$1' },
	{ pattern: /,[mf],d&([ol])/, replacement: ',$1s' },
	{ pattern: /,[mf],s(&\d+)/, replacement: ',xb$1' },
	{ pattern: /,[mf],s&([ol])/, replacement: ',$1b' },
	{ pattern: /^(.*,[fh1]|[xol]b(&\d+)?),[mf],s(.*)$/, replacement: '$1,xb$3#$1$3' },
	{ pattern: /^(.*,[mw0]|[xol]s(&\d+)?),[mf],d(.*)$/, replacement: '$1,xs$3#$1$3' },
	{ pattern: /(,[mw0]|[xol]s(&\d+)?),[mf],s/, replacement: '$1,xb' },
	{ pattern: /(,[fh1]|[xol]b(&\d+)?),[mf],d/, replacement: '$1,xs' },
	{ pattern: /^,[mf],s(.+)?$/, replacement: ',xb$1#,1$1' },
	{ pattern: /^,[mf],d(.+)?$/, replacement: ',xs$1#,0$1' },
	{ pattern: /,[ds](&[ol\d]+)?,[olx]b(&\d+)/g, replacement: ',s$2' },
	{ pattern: /,[ds](&[ol\d]+)?,[olx]s(&\d+)/g, replacement: ',d$2' },
	{ pattern: /,[ds]&o,ob/g, replacement: ',s&o' },
	{ pattern: /,[ds]&o,os/g, replacement: ',d&o' },
	{ pattern: /,[ds]&l,lb/g, replacement: ',s&l' },
	{ pattern: /,[ds]&l,ls/g, replacement: ',d&l' },
	{ pattern: /,[ds](&[ol\d]+)?,[olx]s(&\d+)?/g, replacement: ',d$2' },
	{ pattern: /,[ds](&[ol\d]+)?,[olx]b(&\d+)?/g, replacement: ',s$2' },
	{ pattern: /(,[mwd0]|,[olx]s)(&[ol\d]+)?,[ds](&[ol\d]+)?,m/g, replacement: '$1' },
	{ pattern: /(,[mwd0]|,[olx]s)(&[ol\d]+)?,[ds](&[ol\d]+)?,f/g, replacement: '$1,h' },
	{ pattern: /(,[fhs1]|,[olx]b)(&[ol\d]+)?,[ds](&[ol\d]+)?,f/g, replacement: '$1' },
	{ pattern: /(,[fhs1]|,[olx]b)(&[ol\d]+)?,[ds](&[ol\d]+)?,m/g, replacement: '$1,w' },
	{ pattern: /^,[ds],m(.+)?$/, replacement: ',w$1#$1' },
	{ pattern: /^,[ds],f(.+)?$/, replacement: ',h$1#$1' },
	{ pattern: /,[wh](,[ds])/g, replacement: '$1' },
	{ pattern: /,w,h|,h,w/g, replacement: '' },
	{ pattern: /(.+)?\[([^\|]+?)\|([^\[\]]*\|[^\[\]]*)\](.+)?/g, replacement: '$1$2$4#$1[$3]$4' },
	{ pattern: /(.+)?\[([^\[\]\|]+?)\|([^\[\]\|]+?)?\](.+)?/g, replacement: '$1$2$4#$1$3$4' }
]
