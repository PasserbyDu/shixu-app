<template>
	<tool-page title="宠物管理" subtitle="记下体重、疫苗和驱虫时间，照顾好每个日常" :scrollIntoView="scrollTarget">
		<view class="wellness-heading">
			<text class="heading-text">我的宠物 · {{ pets.length }} 只</text>
			<text class="heading-action" @click="managing = !managing">{{ managing ? '完成' : '管理' }}</text>
		</view>
		<view v-if="pets.length == 0" class="tool-card empty-records">
			<empty-state image="" :description="ready ? '添加宠物，开始记录日常' : '正在读取宠物档案…'" />
		</view>
		<view
			v-for="(pet, index) in pets"
			:key="pet.id"
			:class="['tool-card pet-card', index % 2 == 1 ? 'green-card' : '']"
		>
			<view class="pet-heading">
				<view class="pet-identity" @click="openProfile(pet)">
					<view class="pet-avatar">
						<text class="avatar-label">{{ petInitial(pet.name) }}</text>
					</view>
					<view class="flex-1 min-w-0">
						<text class="pet-name">{{ pet.name }}</text>
						<text class="pet-description">{{ pet.breed.length > 0 ? pet.breed : '品种未填写' }} · {{ petAge(pet.birthday, today) }}</text>
					</view>
				</view>
				<view v-if="managing" class="manage-pet" @click="deletePet(pet)">
					<UniIcons type="closeempty" size="30rpx" color="#8795a1" />
				</view>
				<view v-else class="manage-pet" @click="openProfile(pet)">
					<UniIcons type="right" size="28rpx" color="#8795a1" />
				</view>
			</view>
			<view class="weight-summary">
				<text class="text-[24rpx] leading-[40rpx] text-[#8795a1]">最近体重</text>
				<text class="weight-value">{{ latestWeight(pet) == null ? '未记录' : latestWeight(pet)!.kg + ' kg' }}</text>
				<text class="text-[22rpx] leading-[36rpx] text-[#8795a1]">{{ latestWeight(pet) == null ? '' : latestWeight(pet)!.date.slice(5).replace('-', '/') + ' 记录' }}</text>
			</view>
			<view v-if="reminders" class="reminder-badge">
				<UniIcons type="calendar" size="28rpx" color="#278dca" />
				<text class="reminder-label">{{ petReminder(pet, today) }}</text>
			</view>
			<view class="pet-actions">
				<view class="pet-action" @click="openRecords(pet, 'weight')">
					<text class="text-[26rpx] leading-[42rpx] text-[#278dca]">体重记录</text>
				</view>
				<view class="action-divider" />
				<view class="pet-action" @click="openRecords(pet, 'care')">
					<text class="text-[26rpx] leading-[42rpx] text-[#278dca]">疫苗 / 驱虫</text>
				</view>
			</view>
		</view>
		<text v-if="deletedPet != null" class="secondary-action" @click="undoPet">撤销删除“{{ deletedPet!.name }}”及其记录</text>
		<view class="tool-primary" @click="newPet">
			<UniIcons type="plusempty" size="30rpx" color="#ffffff" />
			<text class="primary-text ml-[12rpx]">添加宠物</text>
		</view>
		<view class="tool-card reminder-settings">
			<view class="reminder-entry" @click="settingsOpen = !settingsOpen">
				<UniIcons type="notification" size="30rpx" color="#278dca" />
				<text class="flex-1 ml-[16rpx] text-[26rpx] leading-[42rpx] text-[#233d50]">提醒设置</text>
				<text class="text-[22rpx] leading-[36rpx] text-[#8795a1]">管理记录提醒 ›</text>
			</view>
			<view v-if="settingsOpen">
				<view class="settings-switch">
					<text class="text-[26rpx] leading-[42rpx] text-[#233d50]">应用内日期提示</text>
					<switch :checked="reminders" :disabled="!ready" color="#278dca" @change="changeReminders" />
				</view>
				<text class="tool-note">只在打开此页时提示日期，不会在后台推送。日期按你填写的记录显示，不自动推算疫苗或驱虫周期。</text>
			</view>
		</view>
		<view v-if="panel == 'profile'" id="pet-profile-form" class="tool-card wellness-form">
			<text class="card-title">{{ editingPetId > 0 ? '编辑宠物' : '添加宠物' }}</text>
			<view class="form-field">
				<text class="form-label">宠物名字</text>
				<input v-model="petName" class="form-input" :maxlength="-1" placeholder="最多30字" />
			</view>
			<view class="form-field">
				<text class="form-label">品种（选填）</text>
				<input v-model="breed" class="form-input" :maxlength="-1" placeholder="最多40字" />
			</view>
			<view class="form-field">
				<text class="form-label">生日（选填）</text>
				<picker
					mode="date"
					:value="birthday.length > 0 ? birthday : today"
					start="1900-01-01"
					:end="today"
					@change="changeBirthday"
				>
					<view class="tool-field">
						<text class="field-value">{{ birthday.length > 0 ? birthday : '选择生日' }}</text>
						<UniIcons type="bottom" size="26rpx" color="#278dca" />
					</view>
				</picker>
				<text v-if="birthday.length > 0" class="tool-note" @click="birthday = ''">清除生日</text>
			</view>
			<text v-if="formError.length > 0" class="form-error">{{ formError }}</text>
			<view class="form-actions">
				<text class="form-cancel" @click="panel = ''">取消</text>
				<text class="form-submit" @click="savePet">保存宠物</text>
			</view>
		</view>
		<view v-if="selectedPet != null && panel == 'weight'" id="pet-weight-form" class="tool-card wellness-form">
			<text class="card-title">{{ selectedPet!.name }} · 体重记录</text>
			<view class="form-field">
				<text class="form-label">记录日期</text>
				<picker mode="date" :value="weightDate" start="1900-01-01" :end="today" @change="changeWeightDate">
					<view class="tool-field">
						<text class="field-value">{{ weightDate }}</text>
						<UniIcons type="bottom" size="26rpx" color="#278dca" />
					</view>
				</picker>
			</view>
			<view class="form-field">
				<text class="form-label">体重（kg，最多3位小数）</text>
				<input v-model="weightValue" class="form-input" type="digit" :maxlength="-1" placeholder="输入体重" />
			</view>
			<text v-if="formError.length > 0" class="form-error">{{ formError }}</text>
			<view class="form-actions">
				<text v-if="editingWeightId > 0" class="form-delete" @click="deleteWeight">删除记录</text>
				<text class="form-cancel" @click="panel = ''">关闭</text>
				<text class="form-submit" @click="saveWeight">{{ editingWeightId > 0 ? '保存修改' : '新增记录' }}</text>
			</view>
			<text class="tool-note">点击下方历史可修改；同一天可保留多次称重。</text>
			<scroll-view class="pet-history" scroll-y="true">
				<empty-state v-if="sortedWeights.length == 0" image="" description="暂无体重记录" />
				<view v-for="entry in sortedWeights" :key="entry.id" class="history-row" @click="editWeight(entry)">
					<view class="history-content">
						<text class="history-title">{{ entry.kg }} kg</text>
						<text class="history-detail">{{ entry.date }}</text>
					</view>
					<UniIcons type="right" size="26rpx" color="#8795a1" />
				</view>
			</scroll-view>
			<text v-if="editingWeightId > 0" class="tool-note" @click="newWeight">继续新增体重</text>
		</view>
		<view v-if="selectedPet != null && panel == 'care'" id="pet-care-form" class="tool-card wellness-form">
			<text class="card-title">{{ selectedPet!.name }} · 疫苗 / 驱虫</text>
			<view class="form-field">
				<text class="form-label">记录类型</text>
				<picker :range="careTypes" :value="careType" @change="changeCareType">
					<view class="tool-field">
						<text class="field-value">{{ careTypes[careType] }}</text>
						<UniIcons type="bottom" size="26rpx" color="#278dca" />
					</view>
				</picker>
			</view>
			<view class="form-field">
				<text class="form-label">项目名称</text>
				<input v-model="careTitle" class="form-input" :maxlength="-1" placeholder="填写项目名称，最多60字" />
			</view>
			<view class="form-field">
				<text class="form-label">本次日期</text>
				<picker mode="date" :value="careDate" start="1900-01-01" :end="today" @change="changeCareDate">
					<view class="tool-field">
						<text class="field-value">{{ careDate }}</text>
						<UniIcons type="bottom" size="26rpx" color="#278dca" />
					</view>
				</picker>
			</view>
			<view class="form-field">
				<text class="form-label">下次日期（选填，自行填写）</text>
				<picker
					mode="date"
					:value="careNext.length > 0 ? careNext : today"
					start="1900-01-01"
					end="2100-12-31"
					@change="changeCareNext"
				>
					<view class="tool-field">
						<text class="field-value">{{ careNext.length > 0 ? careNext : '未设置下次日期' }}</text>
						<UniIcons type="bottom" size="26rpx" color="#278dca" />
					</view>
				</picker>
				<text v-if="careNext.length > 0" class="tool-note" @click="careNext = ''">不设下次日期</text>
			</view>
			<text v-if="formError.length > 0" class="form-error">{{ formError }}</text>
			<view class="form-actions">
				<text v-if="editingCareId > 0" class="form-delete" @click="deleteCare">删除记录</text>
				<text class="form-cancel" @click="panel = ''">关闭</text>
				<text class="form-submit" @click="saveCare">保存记录</text>
			</view>
			<scroll-view class="pet-history" scroll-y="true">
				<empty-state v-if="sortedCare.length == 0" image="" description="暂无疫苗或驱虫记录" />
				<view v-for="entry in sortedCare" :key="entry.id" class="history-row" @click="editCare(entry)">
					<view class="history-content">
						<text class="history-title">{{ careTypes[entry.type] }} · {{ entry.title }}</text>
						<text class="history-detail">{{ entry.date }}{{ entry.next.length > 0 ? ' · 下次 ' + entry.next : '' }}</text>
					</view>
					<UniIcons type="right" size="26rpx" color="#8795a1" />
				</view>
			</scroll-view>
			<text v-if="editingCareId > 0" class="tool-note" @click="newCare">继续新增照护记录</text>
		</view>
		<text v-if="storageError.length > 0" class="tool-footnote">{{ storageError }}</text>
		<text v-if="storageError.length > 0" class="archive-retry" @click="persist(true)">重新保存当前档案</text>
		<text class="tool-footnote">记录保存在本机，支持10只宠物，每只可保存100条体重及100条照护记录。</text>
	</tool-page>
</template>

<script setup lang="uts">
	import { computed, nextTick, ref } from 'vue';
	import { formatCalendarDate } from '@/utils/calculators';
	import {
	Pet,
	PetCare,
	PetWeight,
	decodePets,
	encodePets,
	latestWeight,
	nextRecordId,
	petAge,
	petReminder,
	validateCare,
	validatePet,
	validateWeight,
} from '@/subPackages/life/utils/wellness-data.uts';
	import { petStore, useSavedArchive } from '@/subPackages/life/utils/wellness-storage.uts';
	import { recordToolUsage } from '@/utils/tool-usage';
	import { toast } from '@/utils/toast';
	// data
	const archive = useSavedArchive(petStore);
	const {
		ready,
		storageError
	} = archive;
	const today = ref(formatCalendarDate(new Date()));
	const pets = ref<Pet[]>([]);
	const reminders = ref(true);
	const settingsOpen = ref(false);
	const managing = ref(false);
	const deletedPet = ref<Pet | null>(null);
	const panel = ref('');
	const scrollTarget = ref('');
	const editingPetId = ref(0);
	const selectedPetId = ref(0);
	const petName = ref('');
	const breed = ref('');
	const birthday = ref('');
	const formError = ref('');
	const weightDate = ref(today.value);
	const weightValue = ref('');
	const editingWeightId = ref(0);
	const careTypes = ['疫苗', '驱虫'];
	const careType = ref(0);
	const careTitle = ref('');
	const careDate = ref(today.value);
	const careNext = ref('');
	const editingCareId = ref(0);
	// computed
	const selectedPet = computed((): Pet | null => pets.value.find((pet: Pet): boolean => pet.id == selectedPetId.value) ?? null);
	const sortedWeights = computed((): PetWeight[] => selectedPet.value == null ? [] : selectedPet.value!.weights.slice().sort((a: PetWeight, b: PetWeight): number => a.date == b.date ? b.id - a.id : a.date > b.date ? -1 : 1));
	const sortedCare = computed((): PetCare[] => selectedPet.value == null ? [] : selectedPet.value!.care.slice().sort((a: PetCare, b: PetCare): number => a.date == b.date ? b.id - a.id : a.date > b.date ? -1 : 1));
	// methods
	const petInitial = (name: string): string => {
		const first = name.charCodeAt(0);
		return name.slice(0, first >= 0xd800 && first <= 0xdbff ? 2 : 1);
	};
	const persist = (explicit: boolean = false) => {
		archive.save(encodePets(pets.value, reminders.value), explicit);
	};
	const jump = (id: string) => {
		scrollTarget.value = '';
		nextTick(() => {
			scrollTarget.value = id;
		});
	};
	const openProfile = (pet: Pet) => {
		if (!ready.value) return;
		editingPetId.value = pet.id;
		petName.value = pet.name;
		breed.value = pet.breed;
		birthday.value = pet.birthday;
		formError.value = '';
		panel.value = 'profile';
		jump('pet-profile-form');
	};
	const newPet = () => {
		if (!ready.value) return;
		if (pets.value.length >= 10) return toast('最多添加10只宠物');
		editingPetId.value = 0;
		petName.value = '';
		breed.value = '';
		birthday.value = '';
		formError.value = '';
		panel.value = 'profile';
		jump('pet-profile-form');
	};
	const savePet = () => {
		if (!ready.value) return;
		try {
			const existing = pets.value.find((pet: Pet): boolean => pet.id == editingPetId.value);
			const pet: Pet = {
				id: existing == null ? nextRecordId(pets.value.map((value: Pet): number => value.id).concat(deletedPet.value == null ? [] : [deletedPet.value!.id])) : existing.id,
				name: petName.value.trim(),
				breed: breed.value.trim(),
				birthday: birthday.value,
				weights: existing == null ? [] : existing.weights,
				care: existing == null ? [] : existing.care
			};
			validatePet(pet);
			if (existing == null) {
				if (pets.value.length >= 10) throw new Error('最多添加10只宠物');
				pets.value.push(pet);
			} else pets.value = pets.value.map((value: Pet): Pet => value.id == pet.id ? pet : value);
			panel.value = '';
			uni.hideKeyboard();
			persist();
		} catch (exception) {
			formError.value = (exception as Error).message;
		}
	};
	const deletePet = (pet: Pet) => {
		deletedPet.value = pet;
		pets.value = pets.value.filter((value: Pet): boolean => value.id != pet.id);
		if (panel.value == 'profile' && editingPetId.value == pet.id || (panel.value == 'weight' || panel.value == 'care') && selectedPetId.value == pet.id) panel.value = '';
		if (selectedPetId.value == pet.id) selectedPetId.value = 0;
		if (editingPetId.value == pet.id) editingPetId.value = 0;
		persist();
	};
	const undoPet = () => {
		if (deletedPet.value == null || pets.value.length >= 10) return;
		pets.value.push(deletedPet.value!);
		deletedPet.value = null;
		persist();
	};
	const openRecords = (pet: Pet, mode: string) => {
		today.value = formatCalendarDate(new Date());
		selectedPetId.value = pet.id;
		panel.value = mode;
		formError.value = '';
		if (mode == 'weight') newWeight();else newCare();
		jump(mode == 'weight' ? 'pet-weight-form' : 'pet-care-form');
	};
	const newWeight = () => {
		editingWeightId.value = 0;
		weightDate.value = today.value;
		weightValue.value = '';
		formError.value = '';
	};
	const editWeight = (record: PetWeight) => {
		editingWeightId.value = record.id;
		weightDate.value = record.date;
		weightValue.value = record.kg.toString();
		formError.value = '';
	};
	const saveWeight = () => {
		if (selectedPet.value == null || !ready.value) return;
		try {
			if (!/^\d+(\.\d{1,3})?$/.test(weightValue.value.trim())) throw new Error('请输入有效体重，最多3位小数');
			const pet = selectedPet.value!;
			const weight: PetWeight = {
				id: editingWeightId.value > 0 ? editingWeightId.value : nextRecordId(pet.weights.map((record: PetWeight): number => record.id)),
				date: weightDate.value,
				kg: Number(weightValue.value.trim())
			};
			validateWeight(weight);
			if (editingWeightId.value == 0) {
				if (pet.weights.length >= 100) throw new Error('每只宠物最多保存100条体重记录');
				pet.weights.push(weight);
			} else pet.weights = pet.weights.map((record: PetWeight): PetWeight => record.id == weight.id ? weight : record);
			newWeight();
			uni.hideKeyboard();
			persist();
		} catch (exception) {
			formError.value = (exception as Error).message;
		}
	};
	const deleteWeight = () => {
		if (selectedPet.value == null) return;
		selectedPet.value!.weights = selectedPet.value!.weights.filter((record: PetWeight): boolean => record.id != editingWeightId.value);
		newWeight();
		persist();
	};
	const newCare = () => {
		editingCareId.value = 0;
		careType.value = 0;
		careTitle.value = '';
		careDate.value = today.value;
		careNext.value = '';
		formError.value = '';
	};
	const editCare = (record: PetCare) => {
		editingCareId.value = record.id;
		careType.value = record.type;
		careTitle.value = record.title;
		careDate.value = record.date;
		careNext.value = record.next;
		formError.value = '';
	};
	const saveCare = () => {
		if (selectedPet.value == null || !ready.value) return;
		try {
			const pet = selectedPet.value!;
			const entry: PetCare = {
				id: editingCareId.value > 0 ? editingCareId.value : nextRecordId(pet.care.map((record: PetCare): number => record.id)),
				type: careType.value,
				title: careTitle.value.trim(),
				date: careDate.value,
				next: careNext.value
			};
			validateCare(entry);
			if (editingCareId.value == 0) {
				if (pet.care.length >= 100) throw new Error('每只宠物最多保存100条照护记录');
				pet.care.push(entry);
			} else pet.care = pet.care.map((record: PetCare): PetCare => record.id == entry.id ? entry : record);
			newCare();
			uni.hideKeyboard();
			persist();
		} catch (exception) {
			formError.value = (exception as Error).message;
		}
	};
	const deleteCare = () => {
		if (selectedPet.value == null) return;
		selectedPet.value!.care = selectedPet.value!.care.filter((record: PetCare): boolean => record.id != editingCareId.value);
		newCare();
		persist();
	};
	const changeBirthday = (event: UniPickerChangeEvent) => {
		birthday.value = (event.detail.value as string).replace(/\//g, '-');
	};
	const changeWeightDate = (event: UniPickerChangeEvent) => {
		weightDate.value = (event.detail.value as string).replace(/\//g, '-');
	};
	const changeCareDate = (event: UniPickerChangeEvent) => {
		careDate.value = (event.detail.value as string).replace(/\//g, '-');
	};
	const changeCareNext = (event: UniPickerChangeEvent) => {
		careNext.value = (event.detail.value as string).replace(/\//g, '-');
	};
	const changeCareType = (event: UniPickerChangeEvent) => {
		careType.value = Number(event.detail.value);
	};
	const changeReminders = (event: UniSwitchChangeEvent) => {
		reminders.value = event.detail.value;
		persist();
	};
	// lifecycle
	onLoad(() => {
		recordToolUsage('pet').catch(() => toast('保存使用记录失败'));
		archive.load((snapshot: string) => {
			const data = decodePets(snapshot);
			pets.value = data.pets;
			reminders.value = data.reminders;
		});
	});
	onShow(() => {
		today.value = formatCalendarDate(new Date());
	});
	onUnload(() => {
		archive.dispose();
	});
</script>

<style scoped lang="scss">
	@import '@/styles/wellness-tools.scss';
	.pet-card {
		&.green-card {
			.pet-heading {
				.pet-identity {
					.pet-avatar {
						background-color: #e8f5ef;
						.avatar-label {
							color: #5a9f90;
						}
					}
				}
			}
			.reminder-badge {
				background-color: #e8f5ef;
			}
		}
		.pet-heading {
			display: flex;
			flex-direction: row;
			align-items: center;
			padding-bottom: 24rpx;
			border-bottom: 1rpx solid #e7edf2;
			.pet-identity {
				display: flex;
				flex-direction: row;
				align-items: center;
				flex: 1;
				min-width: 0;
				.pet-avatar {
					display: flex;
					flex-direction: row;
					justify-content: center;
					align-items: center;
					flex-shrink: 0;
					width: 108rpx;
					height: 108rpx;
					margin-right: 26rpx;
					border-radius: 26rpx;
					background-color: #e8f4fc;
					.avatar-label {
						font-size: 48rpx;
						line-height: 68rpx;
						color: #7aa6bd;
					}
				}
				.pet-name {
					display: block;
					font-size: 32rpx;
					line-height: 48rpx;
					color: #233d50;
				}
				.pet-description {
					display: block;
					margin-top: 10rpx;
					font-size: 24rpx;
					line-height: 40rpx;
					color: #8795a1;
				}
			}
			.manage-pet {
				display: flex;
				flex-direction: row;
