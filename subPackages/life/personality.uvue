				font-weight: 500;
				text-align: center;
				color: #43665b;
			}
			.result-summary {
				margin-top: 22rpx;
				font-size: 22rpx;
				line-height: 38rpx;
				text-align: center;
				color: #7e9c8e;
			}
			.result-tags {
				display: flex;
				flex-direction: row;
				flex-wrap: wrap;
				justify-content: center;
				margin-top: 18rpx;
				.result-tag {
					margin: 6rpx;
					padding: 8rpx 24rpx;
					border-radius: 28rpx;
					background-color: #ffffff;
					.result-tag-text {
						font-size: 22rpx;
						line-height: 34rpx;
						color: #6b927f;
					}
				}
			}
			.result-leaf {
				position: relative;
				width: 148rpx;
				height: 62rpx;
				margin-top: 14rpx;
				.leaf-stem {
					position: absolute;
					left: 8rpx;
					bottom: 0;
					width: 132rpx;
					height: 32rpx;
					border-top: 3rpx solid #87ab96;
					border-radius: 50%;
				}
				.leaf-blade {
					position: absolute;
					width: 40rpx;
					height: 20rpx;
					border: 2rpx solid #87ab96;
					border-radius: 0 40rpx 0 40rpx;
					background-color: #d9eadf;
					&.leaf-left {
						left: 8rpx;
						top: 16rpx;
						transform: rotate(28deg);
					}
					&.leaf-middle {
						left: 48rpx;
						top: 32rpx;
						transform: rotate(-20deg);
					}
					&.leaf-right {
						left: 92rpx;
						top: 6rpx;
						transform: rotate(-45deg);
					}
				}
			}
		}
	}
	.stats-row {
		display: flex;
		flex-direction: row;
		.stat-item {
			display: flex;
