			color: #7a8994;
		}
	}
	.personality-content {
		display: flex;
		flex-direction: column;
		padding: 30rpx 38rpx 0;
	}
	.personality-card {
		display: flex;
		flex-direction: column;
		margin-bottom: 38rpx;
		padding: 30rpx;
		border: 1rpx solid #e1e6ee;
		border-radius: 30rpx;
		background-color: #ffffff;
	}
	.section-title {
		font-size: 30rpx;
