<template>
	<view class="personality-page" :class="{ 'is-intro': stage == 'intro' }">
		<scroll-view class="personality-scroll" scroll-y="true" :scroll-top="scrollTop">
			<page-header
				:fixed="false"
				:customCapsuleContent="true"
				contentPadding="0"
				headerClass="page-header-calculator-bg"
			>
				<template #capsule>
					<view class="personality-nav">
						<view class="nav-back" @click="requestBack">
							<UniIcons type="left" size="38rpx" color="#2b7fb5" />
						</view>
						<text class="nav-title">{{ stage == 'result' ? '你的性格画像' : 'INFP 性格测试' }}</text>
						<view class="nav-balance" />
					</view>
				</template>
				<view class="personality-intro">
					<text class="intro-title">{{ stage == 'result' ? '你的性格画像' : 'INFP 性格测试' }}</text>
					<text class="intro-note">{{ stage == 'intro' ? '给自己几分钟，听见内心的声音' : stage == 'questions' ? '慢慢来，跟随你的第一感受' : '24 道题已完成，认识自己又多了一点' }}</text>
				</view>
			</page-header>
			<view v-if="stage == 'intro'" class="personality-content">
				<image src="https://i.postimg.cc/RFj61b2q/infp.png" class="intro-hero-image" mode="aspectFit" />
				<view class="personality-card stats-row">
					<view v-for="stat in stats" :key="stat.value" class="stat-item">
						<text class="stat-value">{{ stat.value }}</text>
						<text class="stat-note">{{ stat.note }}</text>
					</view>
				</view>
				<view class="personality-card">
					<text class="section-title">这次，你将了解</text>
					<view v-for="axis in axes" :key="axis.title" class="axis-intro-row">
						<view class="axis-badge">
							<text class="axis-badge-text">{{ axis.left.slice(-1) }} / {{ axis.right.slice(-1) }}</text>
						</view>
						<view class="axis-description">
							<text class="axis-title">{{ axis.title }}</text>
							<text class="muted-text">{{ axis.note }}</text>
						</view>
					</view>
				</view>
				<view class="personality-note">
					<text class="body-text">没有标准答案，选择更像你的日常</text>
					<text class="muted-text note-space">按近期真实感受作答，不必追求理想中的自己。</text>
				</view>
				<view class="personality-primary" @click="startTest">
					<text class="primary-text">开始探索我的性格</text>
				</view>
				<text class="footer-note">结果仅供自我探索与娱乐，不为你定义边界</text>
				<text class="source-note" @click="sourceDialog?.open()">题目来源与计分说明 ›</text>
			</view>
			<view v-else-if="stage == 'questions'" class="personality-content">
				<view class="personality-card progress-card">
					<view class="progress-heading">
						<text class="body-text">探索进度</text>
						<text class="progress-number">{{ questionIndex + 1 }} / {{ questions.length }}</text>
					</view>
					<view class="progress-track">
						<view class="progress-fill" :style="'width:' + answeredCount / questions.length * 100 + '%;'" />
					</view>
				</view>
				<view class="personality-card question-card">
					<view class="question-badge">
						<text class="question-badge-text">日常情境</text>
					</view>
					<text class="question-text">{{ questions[questionIndex].text }}</text>
					<view
						v-for="option in options"
						:key="option.value"
						class="answer-option"
						:class="{ 'is-selected': answers[questionIndex] == option.value }"
						@click="chooseAnswer(option.value)"
					>
						<UniIcons
							:type="answers[questionIndex] == option.value ? 'checkbox-filled' : 'circle'"
							size="28rpx"
							:color="answers[questionIndex] == option.value ? '#7ea895' : '#b8c5d2'"
						/>
						<text class="answer-label">{{ option.label }}</text>
					</view>
					<text v-if="error.length > 0" class="inline-error">{{ error }}</text>
				</view>
				<text class="footer-note">选好后点击下一题，也可以返回修改答案</text>
				<view class="question-actions">
					<view
						class="personality-secondary previous-button"
						:class="{ 'is-disabled': questionIndex == 0 }"
						@click="previousQuestion"
					>
						<text class="secondary-text">上一题</text>
					</view>
					<view class="personality-primary next-button" @click="nextQuestion">
						<text class="primary-text">{{ questionIndex == questions.length - 1 ? '查看我的结果' : '下一题' }}</text>
					</view>
				</view>
				<text class="footer-note">你的感受没有对错，也不需要被评判</text>
				<text class="source-note" @click="exitDialog?.open()">暂时离开测试</text>
			</view>
			<view v-else-if="result != null" class="personality-content">
				<view class="personality-hero result-hero">
					<text class="result-caption">本次作答呈现的偏好类型</text>
					<text class="result-code">{{ result!.code }}</text>
					<text class="result-title">{{ result!.profile.title }}</text>
					<text class="result-summary">{{ result!.profile.summary }}</text>
					<view class="result-tags">
						<view v-for="tag in result!.profile.tags" :key="tag" class="result-tag">
							<text class="result-tag-text">{{ tag }}</text>
						</view>
					</view>
					<view class="result-leaf">
						<view class="leaf-stem" />
						<view class="leaf-blade leaf-left" />
						<view class="leaf-blade leaf-middle" />
						<view class="leaf-blade leaf-right" />
					</view>
				</view>
				<view class="personality-card">
					<text class="section-title">四个维度，读懂你的偏好</text>
					<text class="muted-text note-space">刻度表示本次作答倾向，没有高低优劣</text>
					<view v-for="score in result!.scores" :key="score.left" class="score-row">
						<view class="score-labels">
							<text class="body-text">{{ score.left }}</text>
							<text class="muted-text">{{ score.right }}</text>
						</view>
						<view class="score-track">
							<view class="score-fill" :style="'width:' + score.percent + '%;background-color:' + score.color" />
							<view class="score-knob" :style="'left:' + score.percent + '%;border-color:' + score.color" />
						</view>
						<text class="score-value" :style="'color:' + score.color">{{ score.balanced ? '50% / 50% · 倾向不明显（X）' : score.percent + '% / ' + score.rightPercent + '%' }}</text>
					</view>
				</view>
				<view class="personality-card">
					<text class="section-title">你可能会共鸣的时刻</text>
					<view v-for="(moment, index) in result!.profile.moments" :key="index" class="moment-row">
						<text class="moment-index">0{{ index + 1 }}</text>
						<text class="moment-text">{{ moment }}</text>
					</view>
				</view>
				<view class="personality-advice">
					<text class="advice-title">给此刻的你，一点小建议</text>
					<text v-for="tip in result!.profile.advice" :key="tip" class="advice-text">{{ tip }}</text>
				</view>
				<view class="personality-primary" :class="{ 'is-disabled': saving }" @click="saveCard">
					<text class="primary-text">{{ saving ? '正在生成卡片…' : '保存我的性格卡片' }}</text>
				</view>
				<text v-if="saveError.length > 0" class="inline-error">{{ saveError }}</text>
				<text class="source-note" @click="requestRestart">重新测试</text>
				<text class="footer-note">仅供自我探索与娱乐，不构成专业心理评估</text>
				<text class="source-note" @click="sourceDialog?.open()">题目来源与计分说明 ›</text>
			</view>
			<view class="safe-area-bottom-pad" />
		</scroll-view>
		<app-dialog
			ref="exitDialog"
			title="暂时离开测试？"
			cancel-text="退出测试"
			:close-on-cancel="false"
			@cancel="abandonTest"
			confirm-text="继续答题"
			@confirm="exitDialog?.close()"
		>
			<text class="dialog-text">你已经完成了 {{ answeredCount }} 道题。</text>
			<text class="dialog-text">退出后，本次未完成的答案将被清空。</text>
		</app-dialog>
		<app-dialog ref="restartDialog" title="重新探索一次？" confirm-text="重新测试" @confirm="restartTest">
			<text class="dialog-text">这次结果已经生成，建议先保存卡片。</text>
			<text class="dialog-text">重新测试会清空答案，并从第 1 题开始。</text>
		</app-dialog>
		<app-dialog
			ref="sourceDialog"
			title="题目来源与计分说明"
			cancel-text=""
			confirm-text="我知道了"
			@confirm="sourceDialog?.close()"
		>
			<text class="dialog-text">24题参考 IPIP Big-Five Factor Markers 公共领域条目进行中文情境改编，四维分组与结果文案为本工具的趣味探索设计，不是官方 MBTI 或经验证的 IPIP 量表。</text>
			<text class="dialog-text">每维度6题，正反向各3题，选项按1—5计分，反向题计为6减去选项分。维度总分6—30线性换算为0—100%的作答倾向，不代表概率或人群排名；同分显示 X。</text>
			<text class="dialog-text">答案和结果仅在当前页面内存中使用，退出即清空；仅点击保存时生成本地图片。</text>
			<text class="source-link" @click="copySources">复制来源网址：IPIP 题库、计分说明、四偏好框架</text>
		</app-dialog>
		<canvas id="personality-poster" canvas-id="personality-poster" type="2d" class="poster-canvas" />
	</view>
</template>

<script setup lang="uts">
	import { computed, nextTick, ref } from 'vue';
	import { onLoad, onReady, onUnload, onBackPress } from '@dcloudio/uni-app';
	// #ifdef MP-WEIXIN
	import { onShareAppMessage, onShareTimeline } from '@dcloudio/uni-app';
	import { createPageShare, createTimelineShare, showPageShareMenu } from '@/utils/page-share.uts';
	// #endif
	import { recordToolUsage } from '@/utils/tool-usage';
	import { toast } from '@/utils/toast';
	import { saveLocalImage } from '@/utils/local-media.uts';
	import { PersonalityResult, PERSONALITY_AXES, PERSONALITY_OPTIONS, PERSONALITY_QUESTIONS, emptyPersonalityAnswers, scorePersonality } from '@/subPackages/life/utils/personality-data.uts';
	import { createPersonalityPoster } from '@/subPackages/life/utils/personality-poster.uts';
	// data
	type DialogRef = {
		open: () => void;
		close: () => void;
	};
	const exitDialog = ref<DialogRef | null>(null),
		restartDialog = ref<DialogRef | null>(null),
		sourceDialog = ref<DialogRef | null>(null);
	const stage = ref('intro'),
		questionIndex = ref(0),
		answers = ref(emptyPersonalityAnswers());
	const result = ref<PersonalityResult | null>(null),
		error = ref(''),
		saveError = ref(''),
		saving = ref(false),
		scrollTop = ref(0);
	const axes = PERSONALITY_AXES,
		options = PERSONALITY_OPTIONS,
		questions = PERSONALITY_QUESTIONS;
	const stats = [{
		value: '24',
		note: '道情境题'
	}, {
		value: '约 4 分钟',
		note: '按直觉作答'
	}, {
		value: '4 个维度',
		note: '看见你的偏好'
	}];
	const poster = createPersonalityPoster('personality-poster');
	let disposed = false,
		canvasReady = false;
	// computed
	const answeredCount = computed((): number => answers.value.filter((value: number): boolean => value > 0).length);
	// methods
	const resetScroll = () => {
		scrollTop.value = 1;
		nextTick(() => {
			if (!disposed) scrollTop.value = 0;
		});
	};
	const startTest = () => {
		answers.value = emptyPersonalityAnswers();
		questionIndex.value = 0;
		result.value = null;
		error.value = '';
		saveError.value = '';
		stage.value = 'questions';
		resetScroll();
	};
	const chooseAnswer = (value: number) => {
		answers.value[questionIndex.value] = value;
		error.value = '';
	};
	const previousQuestion = () => {
		if (questionIndex.value == 0) return;
		questionIndex.value--;
		error.value = '';
		resetScroll();
	};
	const nextQuestion = () => {
		if (answers.value[questionIndex.value] == 0) {
			error.value = '请先选择更符合你的选项';
			return;
		}
		if (questionIndex.value < questions.length - 1) {
			questionIndex.value++;
			error.value = '';
			resetScroll();
			return;
		}
		try {
			result.value = scorePersonality(answers.value);
			stage.value = 'result';
			resetScroll();
		} catch (exception) {
			error.value = exception instanceof Error ? exception.message : '请检查是否有未完成的题目';
		}
	};
	const abandonTest = () => {
		exitDialog.value?.close();
		answers.value = emptyPersonalityAnswers();
		result.value = null;
		questionIndex.value = 0;
		error.value = '';
		stage.value = 'intro';
		resetScroll();
	};
	const requestBack = () => {
		if (saving.value) return toast('请等待卡片处理完成');
		if (stage.value == 'questions') return exitDialog.value?.open();
		if (stage.value == 'result') {
			stage.value = 'intro';
			resetScroll();
			return;
		}
		uni.navigateBack({
			fail: () => uni.switchTab({
				url: '/pages/index/index'
			})
		});
	};
	const requestRestart = () => {
		if (!saving.value) restartDialog.value?.open();
	};
	const restartTest = () => {
		if (saving.value) return;
		restartDialog.value?.close();
		startTest();
	};
	const copySources = () => uni.setClipboardData({
		data: '题库与授权 https://ipip.ori.org/\n条目 https://ipip.ori.org/newBigFive5broadKey.htm\n计分 https://ipip.ori.org/newScoringInstructions.htm\n四偏好框架 https://www.myersbriggs.org/my-mbti-personality-type/the-16-mbti-personality-types/',
		showToast: false,
		success: () => toast('来源网址已复制'),
		fail: () => toast('复制失败，请重试')
	});
	const saveCard = async () => {
		if (saving.value || disposed || result.value == null) return;
		if (!canvasReady) return toast('画布尚未就绪，请稍后重试');
		saving.value = true;
		saveError.value = '';
		try {
			const path = await poster.render(result.value!);
			if (disposed) return;
			// #ifdef WEB
			uni.previewImage({
				urls: [path],
				current: path
			});
			toast('请在预览中长按图片或使用图片菜单保存');
			// #endif
			// #ifndef WEB
			await saveLocalImage(path);
			if (!disposed) toast('性格卡片已保存到相册');
			// #endif
		} catch (exception) {
			if (!disposed) saveError.value = '保存失败，请检查相册权限后重试；测试结果仍保留。' + (exception instanceof Error ? exception.message : '');
		} finally {
			if (disposed) poster.dispose();else saving.value = false;
		}
	};
	// lifecycle
	onLoad(() => {
		recordToolUsage('personality').catch(() => toast('保存使用记录失败'));
		// #ifdef MP-WEIXIN
		showPageShareMenu();
		// #endif
	});
	onReady(() => {
		canvasReady = true;
	});
	onBackPress((): boolean => {
		if (saving.value) return true;
		if (stage.value == 'questions') {
			exitDialog.value?.open();
			return true;
		}
		return false;
	});
	onUnload(() => {
		disposed = true;
		answers.value = emptyPersonalityAnswers();
		result.value = null;
		if (!saving.value) poster.dispose();
	});
	// #ifdef MP-WEIXIN
	const pageShare = createPageShare('INFP 性格测试', '/subPackages/life/personality');
	onShareAppMessage(() => pageShare);
	onShareTimeline(() => createTimelineShare(pageShare));
	// #endif
</script>

<style scoped lang="scss">
	@import '@/uni.scss';
