				color: #8496a5;
			}
		}
	}
	.axis-intro-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-top: 20rpx;
		.axis-badge {
			width: 94rpx;
			padding: 8rpx 0;
			border-radius: 14rpx;
			background-color: #edf5f1;
			.axis-badge-text {
				font-size: 20rpx;
