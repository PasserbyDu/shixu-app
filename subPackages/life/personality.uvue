		padding-bottom: 28rpx;
		border-radius: 38rpx;
		background: linear-gradient(135deg, #e3f3eb, #e8effe);
		overflow: hidden;
		&.result-hero {
			align-items: center;
			padding: 40rpx 24rpx 32rpx;
