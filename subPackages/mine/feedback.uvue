</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { toast } from '@/utils/toast'

	// data
	const isHeaderFixed = ref(false)
	const authorImage = '/static/author.jpg'

	// methods
	const previewAuthor = () => {
		uni.previewImage({
			urls: [authorImage],
			current: authorImage,
			fail: () => toast('二维码预览失败，请重试')
		})
	}
</script>

