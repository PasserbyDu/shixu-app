<template>
	<scroll-view class="feedback-page" scroll-y="true">
		<page-header
			:fixed="isHeaderFixed"
			title="意见反馈"
			titleColor="#ffffff"
			titleFontWeight="500"
			iconColor="#ffffff"
			headerClass="page-header-gradient-bg"
		/>
		<view class="feedback-intro flex flex-col px-[40rpx] pt-[40rpx] pb-[28rpx]">
			<text class="text-[40rpx] leading-[58rpx] font-medium text-color">你的想法，我想听听</text>
			<text class="mt-[16rpx] text-[26rpx] leading-[42rpx] text-color-grey">使用中遇到问题，或是有了新的灵感，欢迎添加微信和我聊聊。</text>
		</view>
		<view class="feedback-card">
			<text class="text-[30rpx] leading-[46rpx] font-medium text-color">扫码添加微信</text>
			<text class="mt-[10rpx] text-[24rpx] leading-[38rpx] text-color-grey">添加时请备注「拾序反馈」</text>
			<image
				class="author-image"
				:src="authorImage"
				mode="aspectFit"
				@click="previewAuthor"
			/>
			<view class="preview-button btn-gradient-bg" @click="previewAuthor">
				<text class="text-[28rpx] leading-[44rpx] font-medium text-white">放大查看二维码</text>
			</view>
			<text class="mt-[24rpx] text-[24rpx] leading-[40rpx] text-center text-color-grey">同一部手机可先截图，再到微信「扫一扫」中从相册识别。</text>
		</view>
		<view class="feedback-guide">
			<text class="text-[28rpx] leading-[44rpx] font-medium text-color">反馈时可以告诉我</text>
