<template>
	<scroll-view class="document-page" scroll-y="true">
		<page-header
			:fixed="isHeaderFixed"
			title="PDF 拆分"
			titleColor="#333333"
			titleFontSize="30rpx"
			titleFontWeight="700"
			headerClass="page-header-calculator-bg"
		/>
		<view class="document-intro">
			<text class="document-heading">PDF 拆分</text>
			<text class="document-description">按页码提取需要的内容，生成一份新的 PDF</text>
		</view>
		<view class="document-card">
			<view class="card-heading"><text class="card-title">PDF 文件</text></view>
			<view v-if="files.length > 0" class="selected-pdf">
				<view class="pdf-icon"><UniIcons type="compose" size="46rpx" color="#277ab8" /></view>
				<view class="pdf-information">
					<text class="pdf-name">{{ files[0].name }}</text>
					<text class="pdf-details">共 {{ files[0].pages }} 页 · {{ formatFileSize(files[0].size) }}</text>
				</view>
				<view class="py-[20rpx] pl-[16rpx]" @click="selectFiles(false, true)">
					<text class="text-[26rpx] text-[#277ab8]">更换</text>
				</view>
			</view>
			<view v-else class="document-empty" @click="selectFiles(false, true)">
				<UniIcons type="compose" size="56rpx" color="#277ab8" />
				<text class="empty-label">选择需要提取页面的 PDF 文件</text>
			</view>
		</view>
		<view class="document-card">
			<view class="card-heading"><text class="card-title">提取方式</text></view>
			<view class="extract-options">
				<view v-for="mode in modes" :key="mode.id" class="extract-option" @click="changeMode(mode.id)">
					<UniIcons :type="modeId == mode.id ? 'checkbox-filled' : 'circle'" size="36rpx" :color="modeId == mode.id ? '#277ab8' : '#708291'" />
					<text class="mode-label" :class="{ 'is-active': modeId == mode.id }">{{ mode.title }}</text>
				</view>
			</view>
			<text class="block mt-[28rpx] mb-[18rpx] text-[24rpx] leading-[36rpx] text-[#708291]">{{ modeId == 'range' ? '输入页码范围' : '输入单个页码' }}</text>
			<input
				v-model="pageInput"
				class="page-range-input"
				type="text"
				maxlength="1000"
				:disabled="busy"
				:placeholder="modeId == 'range' ? '例如：1-3, 5, 8-10' : '例如：3'"
				@input="clearOutput"
			/>
			<text class="document-help">{{ modeId == 'range' ? '用逗号分隔页码，用短横线表示连续页' : '一次提取一个页面，页码从 1 开始' }}</text>
			<text v-if="selectionError.length > 0" class="block mt-[18rpx] text-[22rpx] leading-[36rpx] text-[#c05050]">{{ selectionError }}</text>
			<text v-else-if="selectedPages.length > 0" class="block mt-[18rpx] text-[22rpx] leading-[36rpx] text-[#277ab8]">将提取 {{ selectedPages.length }} 页，去重后按原文档顺序生成</text>
		</view>
		<text v-if="errorText.length > 0" class="document-error">{{ errorText }}</text>
		<view class="document-primary-button" :class="{ 'is-disabled': busy || !supported }" @click="extract">
			<text class="primary-label">{{ busy ? '正在处理，请稍候…' : '提取并生成 PDF' }}</text>
		</view>
		<DocumentResult
			v-if="output != null"
			title="提取完成"
			:path="output.path"
			:name="output.name"
			:size="output.size"
			:pages="output.pages"
			:disabled="busy"
			@busy-change="setExporting"
		/>
		<text class="document-footnote">原文件保持不变。支持 30 MB、200 页以内的文件，只提取有效页码。{{ platformNote }}</text>
		<view class="safe-area-bottom" />
	</scroll-view>
</template>

<script setup lang="uts">
	// #ifdef MP-WEIXIN
	import { onLoad as onSharePageLoad, onShareAppMessage, onShareTimeline } from '@dcloudio/uni-app';
	import { createPageShare, createTimelineShare, showPageShareMenu } from '@/utils/page-share.uts';
	// #endif
	import { computed, ref } from 'vue'
	import DocumentResult from '@/subPackages/office/components/document-result/document-result.uvue'
	import { supportsLocalPdf, pdfPlatformNote } from '@/subPackages/office/utils/pdf-service'
	import { usePdfWorkspace } from '@/subPackages/office/utils/use-pdf-workspace'
	import { parsePageSelection } from '@/subPackages/office/utils/page-selection'
	import { formatFileSize, localOperationError } from '@/utils/local-media'
	import { toast } from '@/utils/toast'

	// data
	type ExtractMode = { id : string, title : string }
	const isHeaderFixed = ref(false)
	const modeId = ref('range')
	const pageInput = ref('')
	const modes : ExtractMode[] = [{ id: 'range', title: '页码范围' }, { id: 'single', title: '单页提取' }]
	const supported = supportsLocalPdf()
	const platformNote = pdfPlatformNote()
	const { files, output, busy, errorText, clearOutput, selectFiles, run, setExporting } = usePdfWorkspace('pdf-split')

	// computed
	const selectionError = computed(() : string => {
		if (pageInput.value.trim().length == 0) return ''
		if (files.value.length == 0) return '请先选择 PDF，读取页数后再设置范围'
		try {
			parsePageSelection(pageInput.value, files.value[0].pages, modeId.value == 'single')
			return ''
		} catch (error) {
			return localOperationError(error)
		}
	})
	const selectedPages = computed(() : number[] => {
		if (files.value.length == 0 || pageInput.value.trim().length == 0 || selectionError.value.length > 0) return []
		return parsePageSelection(pageInput.value, files.value[0].pages, modeId.value == 'single')
	})

	// methods
	const changeMode = (id : string) => {
		if (busy.value || modeId.value == id) return
		modeId.value = id
		pageInput.value = ''
		clearOutput()
	}
	const extract = () => {
		if (busy.value) return
		if (files.value.length == 0) return toast('请先选择 PDF 文件')
		if (selectionError.value.length > 0) return toast(selectionError.value)
		if (selectedPages.value.length == 0) return toast('请输入需要提取的页码')
		run('split', 'A4', '自动', selectedPages.value)
	}

	// 当前页面分享：只分享工具入口，不携带输入或本机数据。
	// #ifdef MP-WEIXIN
	const pageShare = createPageShare("PDF 拆分", "/subPackages/office/pdf-split");
	onSharePageLoad(() => showPageShareMenu());
	onShareAppMessage(() => pageShare);
	onShareTimeline(() => createTimelineShare(pageShare));
	// #endif
</script>

<style scoped lang="scss">
	@import "@/styles/document-tools.scss";

	.document-card {
		.selected-pdf {
			display: flex;
			flex-direction: row;
			align-items: center;
			padding: 12rpx 0;

			.pdf-icon {
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;
				width: 88rpx;
				height: 96rpx;
				border-radius: 24rpx;
				background-color: #e8f4fd;
			}

			.pdf-information {
				display: flex;
				flex-direction: column;
				flex: 1;
				min-width: 0;
				margin-left: 24rpx;

				.pdf-name {
					font-size: 28rpx;
					line-height: 42rpx;
					word-break: break-all;
					color: #243746;
				}

				.pdf-details {
					margin-top: 12rpx;
					font-size: 22rpx;
					line-height: 34rpx;
					color: #708291;
				}
			}
		}

		.extract-options {
			display: flex;
			flex-direction: row;

			.extract-option {
				display: flex;
				flex-direction: row;
				align-items: center;
				flex: 1;
				min-height: 72rpx;

				.mode-label {
					margin-left: 12rpx;
					font-size: 26rpx;
					line-height: 40rpx;
					color: #243746;

					&.is-active {
						color: #277ab8;
					}
				}
			}
		}

		.page-range-input {
			box-sizing: border-box;
			width: 100%;
			height: 96rpx;
			padding: 20rpx 24rpx;
			border: 2rpx solid #e7eef5;
			border-radius: 24rpx;
			font-size: 28rpx;
			color: #243746;
			background-color: #f6f8fa;
		}
	}
</style>
