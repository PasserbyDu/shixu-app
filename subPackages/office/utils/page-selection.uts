// 页码去重、按原文档顺序输出；页码输入均为 1 起始。
export const parsePageSelection = (value : string, total : number, single : boolean) : number[] => {
	const text = value.trim().replace(/，/g, ',').replace(/[–—]/g, '-')
	if (text.length == 0) throw new Error('请输入需要提取的页码')
	if (total <= 0) throw new Error('请先选择有效 PDF')
	if (single && !/^\d+$/.test(text)) throw new Error('单页提取只能输入一个整数页码')
	const selected : number[] = []
	const segments = text.split(',')
	for (let index = 0; index < segments.length; index++) {
		const segment = segments[index].trim()
		if (!/^\d+\s*(-\s*\d+)?$/.test(segment)) throw new Error('页码格式不正确，请参考 1-3, 5, 8-10')
		const endpoints = segment.split('-')
		const start = Number(endpoints[0].trim())
		const end = endpoints.length == 2 ? Number(endpoints[1].trim()) : start
		if (!Number.isInteger(start) || !Number.isInteger(end) || start < 1 || end > total || start > end) {
			throw new Error('页码必须在 1-' + total + ' 内，范围起始页不能大于结束页')
		}
		for (let page = start; page <= end; page++) {
			if (!selected.includes(page - 1)) selected.push(page - 1)
		}
	}
	return selected.sort((first : number, second : number) : number => first - second)
}
