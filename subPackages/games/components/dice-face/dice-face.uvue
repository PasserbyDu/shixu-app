<template>
	<view :class="['dice-face', rolling ? (value % 2 == 0 ? 'is-rolling-left' : 'is-rolling-right') : '']">
		<text v-if="value == 0" class="covered-label">?</text>
		<view v-else class="pip-grid">
			<view v-for="position in positions" :key="position" class="pip-cell">
				<view v-if="pips.includes(position)" :class="['pip', value == 1 ? 'red-pip' : '']" />
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue';
	import { dicePips } from '@/subPackages/games/utils/party-dice.uts';
	const props = defineProps<{
		value: number;
		rolling: boolean;
	}>();
	const positions = [0, 1, 2, 3, 4, 5, 6, 7, 8];
	const pips = computed((): number[] => dicePips(props.value));
</script>

<style scoped lang="scss">
	.dice-face {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		width: 140rpx;
		height: 140rpx;
		margin: 20rpx;
		padding: 20rpx;
		border-radius: 28rpx;
		background-color: #ffffff;
		box-shadow: 0 8rpx 0 #bed9e8;
		transition: transform 90ms;
		&.is-rolling-left {
			transform: rotate(-8deg);
		}
		&.is-rolling-right {
			transform: rotate(8deg);
		}
		.covered-label {
			font-size: 54rpx;
			line-height: 76rpx;
			font-weight: 500;
			color: #a8c9dd;
		}
		.pip-grid {
			display: flex;
			flex-direction: row;
			flex-wrap: wrap;
			width: 100%;
			height: 100%;
			.pip-cell {
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: center;
				width: 33.3333%;
				height: 33.3333%;
				.pip {
					width: 20rpx;
					height: 20rpx;
					border-radius: 10rpx;
					background-color: #2e91c6;
					&.red-pip {
						background-color: #e67c6a;
					}
				}
			}
		}
	}
</style>
