		.intro-title {
			display: block;
			font-size: 46rpx;
			font-weight: 700;
			line-height: 64rpx;
			color: #243b4d;
		}

		.intro-description {
			display: block;
			margin-top: 12rpx;
			font-size: 22rpx;
			line-height: 36rpx;
			color: #8797a5;
		}
	}


	.level-summary {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin: 0 32rpx 38rpx;
		padding: 24rpx 30rpx;
		border-radius: 28rpx;
		background-color: #ffffff;

		.level-information {
			display: flex;
			flex-direction: column;
			flex: 1;
			min-width: 0;

			.level-name {
				margin-top: 8rpx;
				font-size: 34rpx;
				font-weight: 500;
				line-height: 48rpx;
				color: #243b4d;
			}
		}

		.steps-information {
			display: flex;
			flex-direction: column;
			width: 100rpx;
			margin-left: 20rpx;

			.steps-value {
				margin-top: 8rpx;
				font-size: 38rpx;
				font-weight: 500;
				line-height: 48rpx;
				color: #318fc2;

				&.is-long {
					font-size: 30rpx;
				}
			}
		}

		.time-information {
			display: flex;
			flex-direction: column;
			width: 142rpx;
			margin-left: 20rpx;

			.time-value {
				margin-top: 8rpx;
				font-size: 34rpx;
				line-height: 48rpx;
				white-space: nowrap;
				color: #243b4d;

				&.is-long {
					font-size: 24rpx;
				}
			}
		}

		.summary-label {
			display: block;
			font-size: 22rpx;
			line-height: 34rpx;
			color: #8797a5;
		}
	}

	.klotski-board-section {
		display: flex;
		flex-direction: column;
		align-items: center;

		.board-frame {
			position: relative;
			width: 584rpx;
			height: 724rpx;

			.klotski-board {
				position: relative;
				width: 584rpx;
				height: 724rpx;
				border-radius: 28rpx;
				background-color: #dbe8f3;

				.chess-piece {
					position: absolute;
					display: flex;
					flex-direction: row;
					align-items: center;
					justify-content: center;
					box-sizing: border-box;
					border: 3rpx solid transparent;
					border-radius: 18rpx;
					background-color: #ecf8ff;

					&.is-caocao {
						background-color: #2d8fc7;

						.piece-label {
							color: #ffffff;
						}
					}

					&.is-dragging {
						border-color: #7cbfe4;
					}

					.piece-label {
						font-size: 34rpx;
						font-weight: 500;
						line-height: 52rpx;
						white-space: nowrap;
						text-align: center;
						color: #243b4d;
					}
				}
			}

			.board-state {
				position: absolute;
				left: 0;
				right: 0;
				top: 0;
				bottom: 0;
				z-index: 3;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				padding: 36rpx;
				border-radius: 28rpx;
				background-color: rgba(246, 250, 253, 0.96);

				.state-title {
					font-size: 40rpx;
					font-weight: 500;
					line-height: 60rpx;
					text-align: center;
					color: #243b4d;
				}

				.state-description {
					margin: 20rpx 0 28rpx;
					font-size: 24rpx;
					line-height: 40rpx;
					white-space: pre-wrap;
					text-align: center;
					color: #708b9e;
				}

				.state-action {
					display: flex;
					flex-direction: row;
					align-items: center;
					justify-content: center;
					width: 360rpx;
					min-height: 84rpx;
					margin-top: 18rpx;
					border-radius: 20rpx;
					background-color: #2d8fc7;

					&.secondary-action {
						background-color: #e4f3fc;
					}

					.state-action-label {
						font-size: 28rpx;
						line-height: 42rpx;
						text-align: center;
						color: #ffffff;

						&.secondary-label {
							color: #318fc2;
						}
					}
				}
			}
		}

		.exit-label {
			margin-top: 20rpx;
			font-size: 28rpx;
			font-weight: 500;
			line-height: 42rpx;
			text-align: center;
			color: #318fc2;
		}
	}

	.klotski-actions {
		display: flex;
		flex-direction: row;
		margin: 30rpx 32rpx 38rpx;

		.game-button {
			display: flex;
			flex-direction: row;
			align-items: center;
			justify-content: center;
			flex: 1;
			min-width: 0;
			min-height: 90rpx;
			border-radius: 20rpx;
			background-color: #2d8fc7;

			&.undo-button {
				background-color: #e4f3fc;
			}

			&.is-disabled {
				opacity: 0.5;
			}

			.button-label {
				font-size: 28rpx;
				line-height: 42rpx;
				text-align: center;
				color: #ffffff;

				&.undo-label {
					color: #318fc2;
				}
			}
		}
	}

	.klotski-notes {
		display: flex;
		flex-direction: column;
		margin: 0 40rpx 64rpx;

		.notes-text {
			display: block;
			font-size: 22rpx;
			line-height: 38rpx;
			color: #8797a5;
		}
	}

	.storage-message {
		display: block;
		margin: -36rpx 40rpx 60rpx;
		font-size: 22rpx;
		line-height: 36rpx;
		color: #a87947;
	}
</style>
