// methods
export const getKlotskiPieces = (levelIndex : number = 0) : KlotskiPiece[] => {
	const index = Number.isInteger(levelIndex) && levelIndex >= 0 && levelIndex < KLOTSKI_LEVELS.length ? levelIndex : 0
	const level = KLOTSKI_LEVELS[index]
	return KLOTSKI_PIECES.map((piece : KlotskiPiece, pieceIndex : number) : KlotskiPiece => {
		const general = pieceIndex >= 1 && pieceIndex <= 5
		const horizontal = level.horizontal.includes(pieceIndex)
		return {
			id: piece.id,
			label: piece.label,
			width: general ? (horizontal ? 2 : 1) : piece.width,
			height: general ? (horizontal ? 1 : 2) : piece.height,
			start: level.positions[pieceIndex]
		}
	})
}

export const initialKlotski = (levelIndex : number = 0) : number[] => {
	const index = Number.isInteger(levelIndex) && levelIndex >= 0 && levelIndex < KLOTSKI_LEVELS.length ? levelIndex : 0
	return KLOTSKI_LEVELS[index].positions.slice()
}

// 位置为左上角格子的编号。完整验证每枚棋子的边界与占位。
export const klotskiOccupancy = (positions : number[], levelIndex : number = 0) : number[] | null => {
	if (positions.length != KLOTSKI_PIECES.length) return null
	const pieces = getKlotskiPieces(levelIndex)
	const occupied : number[] = []
	for (let index = 0; index < KLOTSKI_COLUMNS * KLOTSKI_ROWS; index++) occupied.push(-1)
	for (let index = 0; index < positions.length; index++) {
		const position = positions[index]
		if (!Number.isInteger(position) || position < 0 || position >= 20) return null
		const piece = pieces[index]
		const x = position % KLOTSKI_COLUMNS
		const y = Math.floor(position / KLOTSKI_COLUMNS)
		if (x + piece.width > KLOTSKI_COLUMNS || y + piece.height > KLOTSKI_ROWS) return null
		for (let row = 0; row < piece.height; row++) {
			for (let column = 0; column < piece.width; column++) {
				const cell = (y + row) * KLOTSKI_COLUMNS + x + column
				if (occupied[cell] != -1) return null
				occupied[cell] = index
			}
		}
	}
	return occupied
}

// 逐格验证整条路径，禁止跨越棋子、斜移、旋转、重叠与越界。
export const moveKlotski = (positions : number[], move : KlotskiMove, levelIndex : number = 0) : number[] | null => {
	if (!Number.isInteger(move.piece) || move.piece < 0 || move.piece >= KLOTSKI_PIECES.length) return null
	if (!Number.isInteger(move.dx) || !Number.isInteger(move.dy)) return null
	if ((move.dx == 0 && move.dy == 0) || (move.dx != 0 && move.dy != 0)) return null
	if (Math.abs(move.dx) > 3 || Math.abs(move.dy) > 4) return null
	const occupied = klotskiOccupancy(positions, levelIndex)
	if (occupied == null) return null
	const piece = getKlotskiPieces(levelIndex)[move.piece]
	const originX = positions[move.piece] % KLOTSKI_COLUMNS
	const originY = Math.floor(positions[move.piece] / KLOTSKI_COLUMNS)
	const distance = Math.abs(move.dx) + Math.abs(move.dy)
	const directionX = move.dx == 0 ? 0 : (move.dx > 0 ? 1 : -1)
	const directionY = move.dy == 0 ? 0 : (move.dy > 0 ? 1 : -1)
	for (let step = 1; step <= distance; step++) {
		const x = originX + directionX * step
		const y = originY + directionY * step
		if (x < 0 || y < 0 || x + piece.width > KLOTSKI_COLUMNS || y + piece.height > KLOTSKI_ROWS) return null
		for (let row = 0; row < piece.height; row++) {
			for (let column = 0; column < piece.width; column++) {
				const other = occupied[(y + row) * KLOTSKI_COLUMNS + x + column]
				if (other != -1 && other != move.piece) return null
			}
		}
	}
	const result = positions.slice()
	result[move.piece] += move.dy * KLOTSKI_COLUMNS + move.dx
	return result
}

export const klotskiWon = (positions : number[]) : boolean => positions.length == 10 && positions[0] == 13

// 沿拖动方向最多可以走几格，供界面限制拖动范围。
export const klotskiDragLimit = (positions : number[], piece : number, horizontal : boolean, sign : number, levelIndex : number = 0) : number => {
	if (sign != -1 && sign != 1) return 0
	let limit = 0
	for (let step = 1; step <= (horizontal ? 3 : 4); step++) {
		const move : KlotskiMove = { piece, dx: horizontal ? step * sign : 0, dy: horizontal ? 0 : step * sign }
		if (moveKlotski(positions, move, levelIndex) == null) break
		limit = step
	}
	return limit
}

export const encodeKlotski = (moves : KlotskiMove[], elapsedMs : number, started : boolean) : string => {
	const history = moves.map((move : KlotskiMove) : string => move.piece + ':' + move.dx + ':' + move.dy).join(';')
	return '1|' + Math.floor(elapsedMs) + '|' + (started ? '1' : '0') + '|' + history
}

// 从初始关卡逐步复演存档，拒绝非法或被修改的布局、越界历史与通关后的移动。
export const decodeKlotski = (serialized : string, levelIndex : number = 0) : KlotskiSave | null => {
	if (!Number.isInteger(levelIndex) || levelIndex < 0 || levelIndex >= KLOTSKI_LEVELS.length) return null
	if (serialized.length == 0 || serialized.length > 100000) return null
	const parts = serialized.split('|')
	if (parts.length != 4 || parts[0] != '1' || !/^\d+$/.test(parts[1])) return null
	const elapsedMs = Number(parts[1])
	if (!Number.isFinite(elapsedMs) || !Number.isInteger(elapsedMs) || elapsedMs > 31536000000) return null
	if (parts[2] != '0' && parts[2] != '1') return null
	const tokens = parts[3].length > 0 ? parts[3].split(';') : []
	if (tokens.length > KLOTSKI_MAX_MOVES) return null
	let positions = initialKlotski(levelIndex)
	const moves : KlotskiMove[] = []
	for (let index = 0; index < tokens.length; index++) {
		if (!/^\d:-?[0-4]:-?[0-4]$/.test(tokens[index]) || klotskiWon(positions)) return null
		const values = tokens[index].split(':')
		const move : KlotskiMove = { piece: Number(values[0]), dx: Number(values[1]), dy: Number(values[2]) }
		const next = moveKlotski(positions, move, levelIndex)
		if (next == null) return null
		positions = next
		moves.push(move)
	}
	const started = parts[2] == '1'
	if (!started && (moves.length > 0 || elapsedMs > 0)) return null
	return { positions, moves, elapsedMs, started }
}

export const encodeKlotskiProgress = (levelIndex : number, snapshots : string[]) : string => {
	return '2|' + levelIndex + '|' + snapshots.join('~')
}

export const decodeKlotskiProgress = (serialized : string) : KlotskiProgress => {
	const snapshots = KLOTSKI_LEVELS.map((_level : KlotskiLevel) : string => '')
	const empty : KlotskiProgress = { levelIndex: 0, snapshots }
	if (serialized.length > KLOTSKI_LEVELS.length * 100001 + 100) return empty
	// 旧版单关存档迁移到第一关。
	if (serialized.startsWith('1|')) {
		if (decodeKlotski(serialized) != null) snapshots[0] = serialized
		return empty
	}
	const separator = serialized.indexOf('|', 2)
	if (!serialized.startsWith('2|') || separator < 0) return empty
	const selected = serialized.substring(2, separator)
	if (!/^\d{1,2}$/.test(selected)) return empty
	const levelIndex = Number(selected)
	if (levelIndex >= KLOTSKI_LEVELS.length) return empty
	const saved = serialized.substring(separator + 1).split('~')
	// 兼容旧版的 10 / 20 关存档，新关卡自动以空进度补齐。
	if (saved.length != 10 && saved.length != 20 && saved.length != KLOTSKI_LEVELS.length) return empty
	if (levelIndex >= saved.length) return empty
	for (let index = 0; index < saved.length; index++) {
		if (decodeKlotski(saved[index], index) != null) snapshots[index] = saved[index]
	}
	return { levelIndex, snapshots }
}

export const formatKlotskiTime = (elapsedMs : number) : string => {
	const seconds = Math.floor(Math.max(0, elapsedMs) / 1000)
	const hours = Math.floor(seconds / 3600)
	const minutes = Math.floor((seconds % 3600) / 60)
	const remaining = seconds % 60
	const minuteText = minutes < 10 ? '0' + minutes : minutes.toString()
	const secondText = remaining < 10 ? '0' + remaining : remaining.toString()
	return hours > 0 ? hours + ':' + minuteText + ':' + secondText : minuteText + ':' + secondText
}
