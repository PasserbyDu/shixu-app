export type KlotskiPiece = {
	id : string
	label : string
	width : number
	height : number
	start : number
}

export type KlotskiMove = {
	piece : number
	dx : number
	dy : number
}

export type KlotskiSave = {
	positions : number[]
	moves : KlotskiMove[]
	elapsedMs : number
	started : boolean
}

export type KlotskiLevel = {
	id : string
	name : string
	positions : number[]
	horizontal : number[]
}

export type KlotskiProgress = {
	levelIndex : number
	snapshots : string[]
}

// data
export const KLOTSKI_COLUMNS = 4
export const KLOTSKI_ROWS = 5
export const KLOTSKI_MAX_MOVES = 10000
export const KLOTSKI_PIECES : KlotskiPiece[] = [
