<template>
	<scroll-view class="document-page" scroll-y="true">
		<page-header
			:fixed="isHeaderFixed"
			title="图片压缩"
			titleColor="#333333"
			titleFontSize="30rpx"
			titleFontWeight="700"
			headerClass="page-header-calculator-bg"
		/>
		<view class="document-intro">
			<text class="document-heading">图片压缩</text>
			<text class="document-description">缩小图片体积，按需要平衡清晰度与文件大小</text>
		</view>
		<view class="local-processing-banner">
			<UniIcons type="checkmarkempty" size="36rpx" color="#277ab8" />
			<text class="banner-label">图片在本地处理，无需上传原图</text>
		</view>
		<view class="document-card">
			<view class="card-heading"><text class="card-title">选择图片</text></view>
			<view v-if="source != null" class="selected-image">
				<image class="source-thumbnail" :src="source.path" mode="aspectFill" @click="previewImage" />
				<view class="source-information">
					<text class="source-name">{{ source.name }}</text>
					<text class="source-details">{{ imageType.toUpperCase() }} · {{ formatFileSize(source.size) }}</text>
					<view class="py-[16rpx]" @click="chooseImage"><text class="text-[26rpx] leading-[40rpx] text-[#277ab8]">重新选择 ＋</text></view>
				</view>
			</view>
			<view v-else class="document-empty" @click="chooseImage">
				<UniIcons type="image" size="56rpx" color="#277ab8" />
				<text class="empty-label">点击选择 JPG 或 PNG 图片</text>
			</view>
		</view>
		<view class="document-card">
			<view class="card-heading">
				<text class="card-title">压缩质量</text>
				<text class="text-[32rpx] leading-[46rpx] text-[#277ab8]">{{ quality }}%</text>
			</view>
			<slider
				:value="quality"
				:min="10"
				:max="100"
				:step="5"
				:disabled="busy"
				activeColor="#65a9df"
				backgroundColor="#e4ebf3"
				block-color="#65a9df"
				:block-size="24"
				@change="changeQuality"
				@changing="changeQuality"
			/>
			<view class="flex flex-row items-center justify-between mt-[18rpx]">
				<text class="text-[22rpx] leading-[34rpx] text-[#708291]">体积更小</text>
				<text class="text-[22rpx] leading-[34rpx] text-[#708291]">更清晰</text>
			</view>
			<text v-if="imageType == 'png'" class="document-help">PNG 为无损格式，质量参数可能不改变体积；若未缩小，将保留原图。</text>
		</view>
		<text v-if="errorText.length > 0" class="document-error">{{ errorText }}</text>
		<view class="document-primary-button" :class="{ 'is-disabled': busy }" @click="compress">
			<text class="primary-label">{{ busy ? '正在处理，请稍候…' : '开始压缩' }}</text>
		</view>
		<view v-if="resultPath.length > 0" class="document-card">
			<view class="card-heading">
				<view class="flex flex-row items-center">
					<UniIcons type="checkmarkempty" size="36rpx" color="#38a38c" />
					<text class="card-title ml-[16rpx]">{{ wasReduced ? '压缩完成' : '处理完成' }}</text>
				</view>
			</view>
			<view class="compression-summary">
				<text class="compressed-size">{{ formatFileSize(resultSize) }}</text>
				<text class="saved-percentage">{{ wasReduced ? (savedPercent > 0 ? '体积减少约 ' + savedPercent + '%' : '体积减少不足 0.1%') : '未缩小，已保留原图' }}</text>
			</view>
			<view class="document-outline-button mt-[24rpx]" @click="saveImage">
				<UniIcons type="download" size="36rpx" color="#277ab8" />
				<text class="outline-label">{{ saving ? '正在保存…' : '保存图片' }}</text>
			</view>
		</view>
		<text class="document-footnote">支持 JPG、PNG，单张不超过 20 MB。压缩效果随图片内容有所不同；原图保持不变。网页端暂不支持此压缩接口，请使用微信小程序或 App。</text>
	</scroll-view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import {
		LocalMediaFile, chooseLocalImages, compressLocalImage, localFileSize,
		formatFileSize, localOperationError, saveLocalImage
	} from '@/utils/local-media'
	import { recordToolUsage } from '@/utils/tool-usage'
	import { toast } from '@/utils/toast'

	// data
	const isHeaderFixed = ref(false)
	const source = ref<LocalMediaFile | null>(null)
	const imageType = ref('')
	const quality = ref(70)
	const busy = ref(false)
	const saving = ref(false)
	const errorText = ref('')
	const resultPath = ref('')
	const resultSize = ref(0)
	let disposed = false

	// computed
	const wasReduced = computed(() : boolean => {
		const original = source.value
		return original != null && resultPath.value.length > 0 && resultSize.value < original.size
	})
	const savedPercent = computed(() : number => {
		const original = source.value
		if (original == null || original.size <= 0 || resultPath.value.length == 0) return 0
		return Math.max(0, Math.floor((1 - resultSize.value / original.size) * 1000) / 10)
	})

	// methods
	const invalidateResult = () => {
		resultPath.value = ''
		resultSize.value = 0
		errorText.value = ''
	}
	const reportError = (error : any) => {
		if (disposed) return
		errorText.value = localOperationError(error)
		if (errorText.value.length > 0) toast(errorText.value)
	}
	const chooseImage = async () => {
		if (busy.value || saving.value) return
		busy.value = true
		errorText.value = ''
		try {
			const files = await chooseLocalImages(1)
			if (disposed || files.length == 0) return
			const selected = files[0]
			if (selected.size > 20 * 1024 * 1024) throw new Error('单张图片不能超过 20 MB')
			const type = await new Promise<string>((resolve, reject) => {
				uni.getImageInfo({
					src: selected.path,
					success: (info) => resolve((info.type ?? '').toLowerCase()),
					fail: () => reject(new Error('无法读取图片，请重新选择'))
				})
			})
			if (type != 'jpg' && type != 'jpeg' && type != 'png') throw new Error('请选择 JPG 或 PNG 图片，暂不支持此图片格式')
			if (disposed) return
			invalidateResult()
			source.value = selected
			imageType.value = type == 'jpeg' ? 'jpg' : type
		} catch (error) {
			reportError(error)
		} finally {
			busy.value = false
		}
	}
	const changeQuality = (event : UniSliderChangeEvent) => {
		if (busy.value || saving.value) return
		const value = Math.max(10, Math.min(100, event.detail.value))
		if (value == quality.value) return
		quality.value = value
		invalidateResult()
	}
	const compress = async () => {
		if (busy.value || saving.value) return
		const original = source.value
		if (original == null) return toast('请先选择图片')
		busy.value = true
		invalidateResult()
		try {
			const path = await compressLocalImage(original.path, quality.value)
			const size = await localFileSize(path)
			if (size <= 0) throw new Error('压缩结果为空，请重新选择图片')
			if (disposed) return
			resultPath.value = size < original.size ? path : original.path
			resultSize.value = Math.min(size, original.size)
		} catch (error) {
			reportError(error)
		} finally {
			busy.value = false
		}
	}
	const previewImage = () => {
		const selected = source.value
		if (selected == null) return
		uni.previewImage({ urls: [selected.path], current: selected.path })
	}
	const saveImage = async () => {
		if (saving.value || busy.value || resultPath.value.length == 0) return
		saving.value = true
		errorText.value = ''
		try {
			await saveLocalImage(resultPath.value)
			if (!disposed) toast('图片已保存到相册')
		} catch (error) {
			reportError(error)
		} finally {
			saving.value = false
		}
	}

	// lifecycle
	onLoad(() => {
		recordToolUsage('image').catch(() => toast('保存使用记录失败'))
	})
	onUnload(() => {
		disposed = true
	})
</script>

<style scoped lang="scss">
	@import "@/styles/document-tools.scss";

	.local-processing-banner {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin: 0 38rpx 28rpx;
		padding: 20rpx 24rpx;
		border-radius: 20rpx;
		background-color: #e8f4fd;

		.banner-label {
			flex: 1;
			margin-left: 16rpx;
			font-size: 24rpx;
			line-height: 38rpx;
			color: #277ab8;
		}
	}

	.document-card {
		.selected-image {
			display: flex;
			flex-direction: row;
			align-items: center;

			.source-thumbnail {
				flex-shrink: 0;
				width: 128rpx;
				height: 128rpx;
				border-radius: 24rpx;
				background-color: #e8f4fd;
			}

			.source-information {
				display: flex;
				flex-direction: column;
				flex: 1;
				min-width: 0;
				margin-left: 28rpx;

				.source-name {
					font-size: 28rpx;
					line-height: 42rpx;
					word-break: break-all;
					color: #243746;
				}

				.source-details {
					margin-top: 12rpx;
					font-size: 22rpx;
					line-height: 36rpx;
					color: #708291;
				}
			}
		}

		.compression-summary {
			display: flex;
			flex-direction: row;
			flex-wrap: wrap;
			align-items: baseline;
			justify-content: space-between;

			.compressed-size {
				margin-right: 20rpx;
				font-size: 52rpx;
				font-weight: 500;
				line-height: 72rpx;
				color: #277ab8;
			}

			.saved-percentage {
				font-size: 24rpx;
				line-height: 38rpx;
				color: #38a38c;
			}
		}
	}
</style>
