			flex-shrink: 0;
			width: 94rpx;
			min-height: 86rpx;
			margin-left: 8rpx;
		}
	}

	.search-body {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-height: 0;
		.initial-state {
			display: flex;
			flex-direction: column;
			flex: 1;
			min-height: 0;
			.history-scroll {
				flex: 1;
				min-height: 0;
				.history-panel {
					padding: 26rpx 32rpx;
					.history-heading {
						display: flex;
						flex-direction: row;
						align-items: center;
						justify-content: space-between;
						.clear-history {
							padding: 10rpx 0 10rpx 28rpx;
							font-size: 24rpx;
							line-height: 40rpx;
							color: #8795a1;
						}
					}
					.history-tags {
						display: flex;
						flex-direction: row;
						flex-wrap: wrap;
