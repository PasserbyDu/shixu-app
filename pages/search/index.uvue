						font-size: 22rpx;
						line-height: 36rpx;
						color: #be5555;
					}
				}
			}
			.initial-hint {
				margin: 26rpx 32rpx 164rpx;
				font-size: 22rpx;
				line-height: 36rpx;
				text-align: center;
				color: #8795a1;
			}
		}
		.result-scroll {
			flex: 1;
			min-height: 0;
			.result-heading {
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: space-between;
				padding: 20rpx 36rpx;
			}
			.result-history-error {
				display: block;
				margin: 0 36rpx 20rpx;
				font-size: 22rpx;
				line-height: 36rpx;
				color: #be5555;
			}
			.result-card {
				display: flex;
				flex-direction: row;
				align-items: center;
				margin: 0 32rpx 16rpx;
				padding: 24rpx;
				border-radius: 30rpx;
				background-color: $uni-bg-color;
				.result-icon {
					display: flex;
					flex-direction: row;
					align-items: center;
					justify-content: center;
					flex-shrink: 0;
					width: 96rpx;
					height: 96rpx;
					border-radius: 24rpx;
				}
				.result-copy {
					flex: 1;
					min-width: 0;
					margin: 0 16rpx 0 24rpx;
					.result-title {
						display: block;
						font-size: 30rpx;
