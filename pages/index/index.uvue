<template>
	<scroll-view class="home-page" scroll-y="true">
		<page-header :fixed="isHeaderFixed" :showCapsule="false" :occupySpace="true">
			<view class="home-hero" :style="heroStyle">
				<!-- 后续将 heroImageUrl 替换为 HTTPS 山水头图地址。 -->
				<image v-if="heroImageUrl.length > 0" class="hero-image" :src="heroImageUrl" mode="aspectFill" />
				<view class="hero-content">
					<text class="text-[52rpx] font-bold text-[#092b4c] leading-[64rpx]">拾序有方</text>
					<view class="flex flex-row items-center justify-between">
						<text class="text-[23rpx] text-[#6e8eaa] leading-[32rpx]">万 事 有 方 ， 生 活 有 序</text>
						<view class="notification" @click="showNotifications">
							<UniIcons type="notification" size="42rpx" color="#123352" />
							<view class="notification-dot" />
						</view>
					</view>
					<text class="mt-[30rpx] text-[40rpx] font-bold text-[#0d3052] leading-[52rpx]">今天也有好方法</text>
					<text class="mt-[8rpx] text-[23rpx] text-[#587d9d] leading-[32rpx]">从一个顺手的工具，开始有序的生活</text>
					<view class="search-box" @click="openToolSearch">
						<UniIcons type="search" size="44rpx" color="#587d9d" />
						<text class="search-placeholder">搜索图片压缩、日期计算、JSON...</text>
					</view>
				</view>
			</view>
		</page-header>

		<view class="home-panel common-panel">
			<view class="panel-heading">
				<text class="text-[29rpx] font-bold text-[#0c2b4c]">常用工具</text>
				<view class="panel-action" @click="openCategories">
					<text class="text-[23rpx] text-[#1888db]">全部工具</text>
					<UniIcons type="right" size="24rpx" color="#1888db" />
				</view>
			</view>
			<view v-if="tools.length > 0" class="tool-grid">
				<view v-for="tool in tools" :key="tool.id" class="tool-card" @click="openTool(tool)">
					<view class="tool-icon">
						<text v-if="tool.iconText.length > 0" class="text-[50rpx] leading-[60rpx]" :style="'color: ' + tool.color + ';'">{{ tool.iconText }}</text>
						<UniIcons v-else-if="tool.icon.length > 0" :type="tool.icon" size="58rpx" :color="tool.color" />
					</view>
					<text class="mt-[14rpx] text-[24rpx] font-medium text-center text-[#123352] leading-[34rpx]">{{ tool.title }}</text>
					<text class="mt-[10rpx] text-[20rpx] text-center text-[#8196ad] leading-[30rpx]">{{ tool.summary }}</text>
					<text class="mt-[8rpx] text-[20rpx] text-center text-[#1888db] leading-[30rpx]">使用 {{ getUsageCount(tool.id) }} 次</text>
				</view>
			</view>
			<empty-state v-else image="" description="使用工具后会在这里显示常用工具" />
		</view>

		<view class="home-panel category-panel">
			<view class="panel-heading">
				<text class="text-[29rpx] font-bold text-[#0c2b4c]">工具分类</text>
				<view class="panel-action" @click="openCategories">
					<text class="text-[23rpx] text-[#66839e]">全部分类</text>
					<UniIcons type="right" size="24rpx" color="#66839e" />
				</view>
			</view>
			<view class="category-grid">
				<view
					v-for="category in categories"
					:key="category.id"
					class="category-card"
					:style="'background-color: ' + category.background + ';'"
					@click="openToolCategory(category.id)"
				>
					<view class="category-icon">
						<text v-if="category.id == 'development'" class="text-[38rpx] text-[#0096f7]">{ }</text>
						<UniIcons v-else :type="category.icon" size="42rpx" :color="category.color" />
					</view>
					<view class="flex flex-col flex-1 min-w-0">
						<text class="text-[24rpx] font-medium text-[#1a3c5a] leading-[34rpx]">{{ category.title }}</text>
						<text class="mt-[10rpx] text-[20rpx] text-[#8397a9] leading-[30rpx]">{{ category.subtitle }}</text>
					</view>
					<UniIcons type="right" size="16rpx" :color="category.color" />
				</view>
			</view>
		</view>

		<view class="home-panel recent-panel">
			<view class="panel-heading">
				<text class="text-[29rpx] font-bold text-[#0c2b4c]">最近使用</text>
				<view class="panel-action" @click="clearHistory">
					<text class="text-[23rpx] text-[#66839e]">清空记录</text>
					<UniIcons type="right" size="24rpx" color="#66839e" />
				</view>
			</view>
			<view v-if="recentTools.length > 0" class="recent-list">
				<view v-for="tool in recentTools" :key="tool.id" class="recent-row">
					<view class="recent-entry" @click="openTool(tool)">
						<view class="recent-icon" :style="'background-color: ' + tool.background + ';'">
							<text v-if="tool.iconText.length > 0" class="text-[36rpx]" :style="'color: ' + tool.color + ';'">{{ tool.iconText }}</text>
							<UniIcons v-else-if="tool.icon.length > 0" :type="tool.icon" size="42rpx" :color="tool.color" />
						</view>
						<view class="recent-copy">
							<view class="recent-title-row">
								<text class="text-[24rpx] font-medium text-[#183756] leading-[34rpx]">{{ tool.title }}</text>
								<text class="recent-time">{{ getRecentTime(tool.id) }}</text>
							</view>
							<text class="recent-description">{{ tool.description }}</text>
						</view>
					</view>
					<view class="recent-more" @click="toggleRecentActions(tool.id)">
						<UniIcons type="more-filled" size="32rpx" color="#70849b" />
					</view>
					<view v-if="activeRecentId == tool.id" class="recent-actions">
						<text class="text-[24rpx] text-[#66839e]" @click="removeRecent(tool.id)">移除此记录</text>
						<text class="text-[24rpx] text-[#66839e]" @click="closeRecentActions">取消</text>
					</view>
				</view>
			</view>
			<empty-state v-else image="" description="暂无使用记录" />
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import { Tool, getToolCategories } from '@/config/tools'
	import {
		ToolUsage,
		FrequentToolUsage,
		clearToolHistory,
		formatUsageTime,
		getRecentToolUsages,
		getFrequentToolUsages,
		removeToolUsage
	} from '@/utils/tool-usage'
	import { getNavBarInfo } from '@/utils/system'
	import { toast } from '@/utils/toast'
	import { openToolSearch } from '@/utils/tool-search'
	import { navigateToTool } from '@/utils/tool-navigation'
	import { openToolCategory } from '@/utils/category-navigation'

	// data
	const isHeaderFixed = ref(false)
	const heroImageUrl = ref('https://i.postimg.cc/tTMT1z8W/P01-home-hero.png')
	const activeRecentId = ref('')
	const navBarInfo = getNavBarInfo()
	const frequentUsages = ref<FrequentToolUsage[]>([])
	const categories = getToolCategories()
	const recentUsages = ref<ToolUsage[]>([])
	const recentTools = ref<Tool[]>([])

	// computed
	const tools = computed(() : Tool[] => frequentUsages.value.slice(0, 4).map((item : FrequentToolUsage) : Tool => item.tool))
	const heroStyle = computed(() : string => {
		return 'padding-top: ' + (navBarInfo.statusBarHeightRpx + 14) + 'rpx;'
	})

	// methods
	const getUsageCount = (id : string) : number => {
		return frequentUsages.value.find((item : FrequentToolUsage) : boolean => item.tool.id == id)?.count ?? 0
	}
	const getRecentTime = (id : string) : string => {
		const usage = recentUsages.value.find((item : ToolUsage) : boolean => item.tool.id == id)
		return usage == null ? '' : formatUsageTime(usage.usedAt)
	}
	const openCategories = () => {
		openToolCategory('all')
	}
	const openTool = (tool : Tool) => {
		navigateToTool(tool)
	}
	const showNotifications = () => {
		toast('暂无新消息')
	}
	const clearHistory = async () => {
		if (recentTools.value.length == 0) return toast('暂无使用记录')
		try {
			await clearToolHistory()
		} catch (error) {
			toast('清理失败，请重试')
			return
		}
		recentTools.value = []
		recentUsages.value = []
		activeRecentId.value = ''
	}
	const toggleRecentActions = (id : string) => {
		activeRecentId.value = activeRecentId.value == id ? '' : id
	}
	const closeRecentActions = () => {
		activeRecentId.value = ''
	}
	const removeRecent = async (id : string) => {
		try {
			await removeToolUsage(id)
			recentUsages.value = (await getRecentToolUsages()).slice(0, 5)
			recentTools.value = recentUsages.value.map((item : ToolUsage) : Tool => item.tool)
		} catch (error) {
			toast('移除记录失败，请重试')
			return
		}
		activeRecentId.value = ''
	}

	// lifecycle
	onShow(async () => {
		try {
			frequentUsages.value = await getFrequentToolUsages()
			recentUsages.value = (await getRecentToolUsages()).slice(0, 5)
			recentTools.value = recentUsages.value.map((item : ToolUsage) : Tool => item.tool)
			activeRecentId.value = ''
		} catch (error) {
			toast('读取使用记录失败，请重试')
		}
	})
</script>

